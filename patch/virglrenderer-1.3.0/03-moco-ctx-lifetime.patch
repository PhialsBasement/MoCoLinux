diff --color -ru a/src/virgl_util.c b/src/virgl_util.c
--- a/src/virgl_util.c	2026-08-11 18:24:02.361171016 +1000
+++ b/src/virgl_util.c	2026-08-11 18:22:45.976915998 +1000
@@ -270,13 +270,39 @@
 {
    char *str = NULL;
 
-   if (!virgl_log_data.log_cb)
-      return;
-
    if (vasprintf(&str, fmt, va) < 0)
       return;
 
-   virgl_log_data.log_cb(log_level, str, virgl_log_data.user_data);
+   /*
+    * MoCoLinux: the renderer writes its own file, from inside the renderer.
+    *
+    * Every other route out of this DLL is a dead end. The host daemon
+    * freopen()s its stderr to cogpu-vrend.log and that file has been 0 bytes
+    * through every failure it was meant to explain, because this is a DLL
+    * with its own C runtime and its stderr is a different stream. The
+    * documented log callback is no better: virgl_set_debug_callback()
+    * replaces the handler with a legacy wrapper defaulting to
+    * virgl_null_logger, so messages can start reaching a callback and then
+    * silently stop.
+    *
+    * Neither the daemon nor anything else gets to decide whether the renderer
+    * can speak. This file is opened here, with this DLL's fopen, unbuffered,
+    * and written before any callback is consulted.
+    */
+   {
+      static FILE *own;
+
+      if (!own) {
+         own = fopen("C:\\MoCoLinux\\virgl-direct.log", "w");
+         if (own)
+            setvbuf(own, NULL, _IONBF, 0);
+      }
+      if (own)
+         fputs(str, own);
+   }
+
+   if (virgl_log_data.log_cb)
+      virgl_log_data.log_cb(log_level, str, virgl_log_data.user_data);
    free (str);
 }
 
