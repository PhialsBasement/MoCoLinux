 void flush_eventfd(int fd)
 {
+#ifdef _WIN32
+   HANDLE event = (HANDLE)_get_osfhandle(fd);
+   if (event != INVALID_HANDLE_VALUE)
+      ResetEvent(event);
+#else
     ssize_t len;
     uint64_t value;
     do {
        len = read(fd, &value, sizeof(value));
     } while ((len == -1 && errno == EINTR) || len == sizeof(value));
+#endif
 }
 
