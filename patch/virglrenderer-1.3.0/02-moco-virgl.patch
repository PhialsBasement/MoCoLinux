+/* MoCoLinux CoPresent: show a resource in one of the guest's X windows.
+ *
+ * The whole point of carrying this in the command stream is that a client
+ * needs nothing beyond the render node it is already rendering through, so
+ * sandboxes and containers require no configuration. Ordering is implicit:
+ * the command follows the draws it presents in the same buffer.
+ */
+static int vrend_decode_moco_present(struct vrend_context *ctx,
+                                     const uint32_t *buf, uint32_t length)
+{
+   uint32_t res_handle;
+   struct vrend_resource *res;
+
+   if (length != VIRGL_MOCO_PRESENT_SIZE)
+      return EINVAL;
+
+   res_handle = get_buf_entry(buf, VIRGL_MOCO_PRESENT_RES_HANDLE);
+
+   /* A context may only present what it owns. */
+   res = vrend_renderer_ctx_res_lookup(ctx, res_handle);
+   if (!res) {
+      vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE,
+                                 res_handle);
+      return EINVAL;
+   }
+
+   if (!vrend_clicbs->moco_present)
+      return 0;      /* host does not implement presentation; harmless */
+
+   vrend_clicbs->moco_present(res_handle,
+                              get_buf_entry(buf, VIRGL_MOCO_PRESENT_XID),
+                              get_buf_entry(buf, VIRGL_MOCO_PRESENT_WIDTH),
+                              get_buf_entry(buf, VIRGL_MOCO_PRESENT_HEIGHT),
+                              get_buf_entry(buf, VIRGL_MOCO_PRESENT_DAMAGE_X),
+                              get_buf_entry(buf, VIRGL_MOCO_PRESENT_DAMAGE_Y),
+                              get_buf_entry(buf, VIRGL_MOCO_PRESENT_DAMAGE_WIDTH),
+                              get_buf_entry(buf, VIRGL_MOCO_PRESENT_DAMAGE_HEIGHT));
+   return 0;
+}
