diff -ruN a/src/gallium/frontends/glx/xlib/moco_present.c b/src/gallium/frontends/glx/xlib/moco_present.c
--- a/src/gallium/frontends/glx/xlib/moco_present.c	1970-01-01 10:00:00.000000000 +1000
+++ b/src/gallium/frontends/glx/xlib/moco_present.c	2026-08-09 16:49:34.907267934 +1000
@@ -0,0 +1,397 @@
+/*
+ * Direct virgl presentation for MoCoLinux's client-side GLX frontend.
+ *
+ * X remains the control plane: the application owns an ordinary XID and
+ * receives its normal events from the stock server.  The colour resource,
+ * however, is exported as a dma-buf and presented through CoPresent.  Only
+ * resource identity, damage, and a native acquire fence cross the boundary.
+ */
+
+#include "moco_present.h"
+#include "moco_present_protocol.h"
+
+#include "frontend/winsys_handle.h"
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#define MOCO_PRESENT_BUFFERS 4
+
+struct moco_binding {
+   struct pipe_resource *resource;
+   uint32_t id;
+   bool bound;
+   bool busy;
+};
+
+struct moco_present {
+   int socket_fd;
+   uint32_t xid;
+   uint32_t serial;
+   uint32_t width;
+   uint32_t height;
+   bool announced;
+   struct moco_binding bindings[MOCO_PRESENT_BUFFERS];
+};
+
+static int
+connect_broker(void)
+{
+   struct sockaddr_un address;
+   int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+
+   if (fd < 0)
+      return -1;
+   memset(&address, 0, sizeof(address));
+   address.sun_family = AF_UNIX;
+   snprintf(address.sun_path, sizeof(address.sun_path), "%s",
+            COPRESENT_LOCAL_PATH);
+   if (connect(fd, (struct sockaddr *)&address, sizeof(address)) != 0) {
+      close(fd);
+      return -1;
+   }
+   return fd;
+}
+
+static int
+send_record_fd(int socket_fd, const struct copresent_record *record,
+               int passed_fd)
+{
+   struct iovec iov = {
+      .iov_base = (void *)record,
+      .iov_len = sizeof(*record),
+   };
+   char control[CMSG_SPACE(sizeof(int))];
+   struct msghdr message;
+
+   memset(&message, 0, sizeof(message));
+   message.msg_iov = &iov;
+   message.msg_iovlen = 1;
+   if (passed_fd >= 0) {
+      struct cmsghdr *cmsg;
+
+      memset(control, 0, sizeof(control));
+      message.msg_control = control;
+      message.msg_controllen = sizeof(control);
+      cmsg = CMSG_FIRSTHDR(&message);
+      cmsg->cmsg_level = SOL_SOCKET;
+      cmsg->cmsg_type = SCM_RIGHTS;
+      cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+      memcpy(CMSG_DATA(cmsg), &passed_fd, sizeof(passed_fd));
+   }
+
+   return sendmsg(socket_fd, &message, MSG_NOSIGNAL) == sizeof(*record) ?
+          0 : -1;
+}
+
+static struct moco_binding *
+binding_by_id(struct moco_present *present, uint32_t id)
+{
+   unsigned i;
+
+   for (i = 0; i < MOCO_PRESENT_BUFFERS; i++)
+      if (present->bindings[i].bound && present->bindings[i].id == id)
+         return &present->bindings[i];
+   return NULL;
+}
+
+static int
+receive_response(struct moco_present *present,
+                 struct copresent_record *response)
+{
+   ssize_t got = recv(present->socket_fd, response, sizeof(*response), 0);
+   struct moco_binding *binding;
+
+   if (got != sizeof(*response) ||
+       response->version != COPRESENT_VERSION)
+      return -1;
+
+   binding = binding_by_id(present, response->buffer);
+   if (binding && response->opcode == COPRESENT_RELEASE)
+      binding->busy = false;
+
+   if (response->status != COPRESENT_OK) {
+      fprintf(stderr,
+              "MoCo GLX: CoPresent opcode 0x%x buffer %u failed (%u)\n",
+              response->opcode, response->buffer, response->status);
+   }
+   return 0;
+}
+
+static int
+wait_for_response(struct moco_present *present, uint32_t opcode,
+                  uint32_t buffer)
+{
+   for (;;) {
+      struct copresent_record response;
+
+      if (receive_response(present, &response) != 0)
+         return -1;
+      if (response.buffer == buffer &&
+          (response.opcode == opcode ||
+           response.opcode == COPRESENT_ERROR))
+         return response.opcode == opcode &&
+                response.status == COPRESENT_OK ? 0 : -1;
+   }
+}
+
+static void
+disconnect_broker(struct moco_present *present)
+{
+   unsigned i;
+
+   if (present->socket_fd >= 0)
+      close(present->socket_fd);
+   present->socket_fd = -1;
+   present->width = 0;
+   present->height = 0;
+   for (i = 0; i < MOCO_PRESENT_BUFFERS; i++)
+      memset(&present->bindings[i], 0, sizeof(present->bindings[i]));
+}
+
+static int
+ensure_connected(struct moco_present *present)
+{
+   if (present->socket_fd >= 0)
+      return 0;
+
+   present->socket_fd = connect_broker();
+   if (present->socket_fd < 0) {
+      fprintf(stderr, "MoCo GLX: cannot connect to %s: %s\n",
+              COPRESENT_LOCAL_PATH, strerror(errno));
+      return -1;
+   }
+   return 0;
+}
+
+static struct moco_binding *
+binding_for_resource(struct moco_present *present,
+                     struct pipe_resource *resource)
+{
+   unsigned i;
+
+   for (i = 0; i < MOCO_PRESENT_BUFFERS; i++)
+      if (present->bindings[i].bound &&
+          present->bindings[i].resource == resource)
+         return &present->bindings[i];
+   for (i = 0; i < MOCO_PRESENT_BUFFERS; i++) {
+      if (!present->bindings[i].bound) {
+         present->bindings[i].resource = resource;
+         present->bindings[i].id = i;
+         return &present->bindings[i];
+      }
+   }
+   return NULL;
+}
+
+static int
+bind_resource(struct moco_present *present,
+              struct moco_binding *binding,
+              struct pipe_screen *screen,
+              struct pipe_context *context,
+              struct pipe_resource *resource,
+              uint32_t width, uint32_t height)
+{
+   struct winsys_handle handle;
+   struct copresent_record record;
+   int dma_fd;
+
+   memset(&handle, 0, sizeof(handle));
+   handle.type = WINSYS_HANDLE_TYPE_FD;
+   if (!screen->resource_get_handle(screen, context, resource, &handle,
+                                    PIPE_HANDLE_USAGE_EXPLICIT_FLUSH |
+                                    PIPE_HANDLE_USAGE_FRAMEBUFFER_WRITE)) {
+      fprintf(stderr, "MoCo GLX: virgl dma-buf export failed\n");
+      return -1;
+   }
+   dma_fd = (int)handle.handle;
+
+   memset(&record, 0, sizeof(record));
+   record.opcode = COPRESENT_BIND;
+   record.version = COPRESENT_VERSION;
+   record.buffer = binding->id;
+   record.xid = present->xid;
+   record.width = width;
+   record.height = height;
+   if (send_record_fd(present->socket_fd, &record, dma_fd) != 0) {
+      close(dma_fd);
+      return -1;
+   }
+   close(dma_fd);
+   if (wait_for_response(present, COPRESENT_BOUND, binding->id) != 0)
+      return -1;
+
+   binding->bound = true;
+   return 0;
+}
+
+static int
+wait_until_idle(struct moco_present *present, struct moco_binding *binding)
+{
+   while (binding->busy) {
+      if (wait_for_response(present, COPRESENT_RELEASE, binding->id) != 0)
+         return -1;
+   }
+   return 0;
+}
+
+struct moco_present *
+moco_present_create(uint32_t xid)
+{
+   struct moco_present *present = calloc(1, sizeof(*present));
+
+   if (!present)
+      return NULL;
+   present->socket_fd = -1;
+   present->xid = xid;
+   return present;
+}
+
+bool
+moco_present_frame(struct moco_present *present,
+                   struct pipe_screen *screen,
+                   struct pipe_context *context,
+                   struct pipe_resource *resource,
+                   uint32_t width, uint32_t height,
+                   unsigned nboxes, const struct pipe_box *boxes)
+{
+   struct moco_binding *binding;
+   struct pipe_fence_handle *fence = NULL;
+   struct copresent_record record;
+   int fence_fd = -1;
+   bool ok = false;
+
+   if (!present || !screen || !context || !resource ||
+       width == 0 || height == 0 || ensure_connected(present) != 0)
+      return false;
+
+   if ((present->width && present->width != width) ||
+       (present->height && present->height != height))
+      moco_present_reset(present);
+   if (ensure_connected(present) != 0)
+      return false;
+   present->width = width;
+   present->height = height;
+
+   binding = binding_for_resource(present, resource);
+   if (!binding) {
+      moco_present_reset(present);
+      if (ensure_connected(present) != 0)
+         return false;
+      present->width = width;
+      present->height = height;
+      binding = binding_for_resource(present, resource);
+   }
+   if (!binding || wait_until_idle(present, binding) != 0)
+      goto fail;
+   if (!binding->bound &&
+       bind_resource(present, binding, screen, context, resource,
+                     width, height) != 0)
+      goto fail;
+
+   context->flush(context, &fence,
+                  PIPE_FLUSH_FENCE_FD | PIPE_FLUSH_END_OF_FRAME);
+   if (!fence || !screen->fence_get_fd)
+      goto out;
+   fence_fd = screen->fence_get_fd(screen, fence);
+   if (fence_fd < 0)
+      goto out;
+
+   memset(&record, 0, sizeof(record));
+   record.opcode = COPRESENT_PRESENT;
+   record.version = COPRESENT_VERSION;
+   record.buffer = binding->id;
+   record.serial = ++present->serial;
+   /* XMesa's window-system framebuffer is Y_0_TOP.  The host combines
+    * this logical orientation with virglrenderer's resource-storage flag. */
+   record.flags = COPRESENT_F_Y_0_TOP;
+   if (nboxes == 1 && boxes) {
+      record.damage_x = boxes[0].x;
+      record.damage_y = boxes[0].y;
+      record.damage_width = boxes[0].width;
+      record.damage_height = boxes[0].height;
+   } else {
+      record.damage_width = width;
+      record.damage_height = height;
+   }
+
+   if (send_record_fd(present->socket_fd, &record, fence_fd) != 0)
+      goto out;
+   binding->busy = true;
+   if (wait_until_idle(present, binding) != 0)
+      goto out;
+
+   if (!present->announced) {
+      fprintf(stderr,
+              "MoCo GLX: direct virgl/CoPresent active for XID 0x%x\n",
+              present->xid);
+      present->announced = true;
+   }
+   ok = true;
+
+out:
+   if (fence_fd >= 0)
+      close(fence_fd);
+   if (fence)
+      screen->fence_reference(screen, &fence, NULL);
+   if (ok)
+      return true;
+fail:
+   fprintf(stderr, "MoCo GLX: direct present failed for XID 0x%x\n",
+           present->xid);
+   disconnect_broker(present);
+   return false;
+}
+
+void
+moco_present_reset(struct moco_present *present)
+{
+   unsigned i;
+
+   if (!present || present->socket_fd < 0)
+      return;
+
+   for (i = 0; i < MOCO_PRESENT_BUFFERS; i++) {
+      struct moco_binding *binding = &present->bindings[i];
+      struct copresent_record record;
+
+      if (!binding->bound)
+         continue;
+      if (wait_until_idle(present, binding) != 0)
+         goto fail;
+      memset(&record, 0, sizeof(record));
+      record.opcode = COPRESENT_UNBIND;
+      record.version = COPRESENT_VERSION;
+      record.buffer = binding->id;
+      if (send_record_fd(present->socket_fd, &record, -1) != 0 ||
+          wait_for_response(present, COPRESENT_UNBOUND, binding->id) != 0)
+         goto fail;
+      memset(binding, 0, sizeof(*binding));
+   }
+   present->width = 0;
+   present->height = 0;
+   return;
+
+fail:
+   disconnect_broker(present);
+}
+
+void
+moco_present_destroy(struct moco_present *present)
+{
+   if (!present)
+      return;
+   moco_present_reset(present);
+   if (present->socket_fd >= 0)
+      close(present->socket_fd);
+   free(present);
+}
