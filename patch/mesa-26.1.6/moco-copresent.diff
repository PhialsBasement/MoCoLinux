--- a/src/gallium/frontends/dri/moco_dri3.h	1970-01-01 10:00:00.000000000 +1000
+++ b/src/gallium/frontends/dri/moco_dri3.h	2026-08-10 01:48:31.856139700 +1000
@@ -0,0 +1,48 @@
+#ifndef MESA_MOCO_DRI3_H
+#define MESA_MOCO_DRI3_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <xcb/xcb.h>
+
+struct moco_dri3_present;
+struct pipe_context;
+struct pipe_resource;
+
+/*
+ * MoCoLinux CoPresent.
+ *
+ * Presentation is carried as an ordinary command inside the client's own
+ * virgl command stream, down the render node it is already drawing through.
+ * That is the whole design: a client that can render can present, so
+ * sandboxed applications and containers -- a browser content process, a Steam
+ * title inside pressure-vessel -- work with no socket, no extra device, no
+ * filesystem share and no per-application configuration.
+ *
+ * This object holds only what the stream cannot carry by itself: the
+ * top-level XID the frames belong to.
+ */
+struct moco_dri3_present *moco_dri3_present_create(xcb_connection_t *conn,
+                                                   uint32_t xid);
+void moco_dri3_present_destroy(struct moco_dri3_present *present);
+
+/* The resolved top-level XID; 0 if it could not be determined. */
+uint32_t moco_dri3_present_xid(struct moco_dri3_present *present);
+
+/* Announce the first successful frame once, for the log. */
+bool moco_dri3_present_announce(struct moco_dri3_present *present);
+
+/*
+ * Emit the presentation command. Defined in the virgl driver
+ * (src/gallium/drivers/virgl/virgl_encode.c); both it and this frontend end
+ * up inside libgallium, so this is a direct call rather than a transport.
+ */
+void virgl_moco_encode_present(struct pipe_context *pctx,
+                               struct pipe_resource *pres,
+                               uint32_t xid,
+                               uint32_t width, uint32_t height,
+                               uint32_t damage_x, uint32_t damage_y,
+                               uint32_t damage_width, uint32_t damage_height);
+
+#endif
diff --color -ruN '--exclude=__pycache__' '--exclude=.moco-copresent-patch-sha256' '--exclude=build*' a/src/gallium/frontends/dri/moco_dri3_protocol.h b/src/gallium/frontends/dri/moco_dri3_protocol.h
--- a/src/gallium/frontends/dri/moco_dri3_protocol.h	1970-01-01 10:00:00.000000000 +1000
+++ b/src/gallium/frontends/dri/moco_dri3_protocol.h	2026-08-09 21:52:04.142436800 +1000
@@ -0,0 +1,57 @@
+/*
+ * MoCoLinux CoPresent wire ABI.  Keep this layout in sync with
+ * src/colinux/user/copresent/copresent.h in MoCoLinux.
+ */
+#ifndef MESA_MOCO_DRI3_PROTOCOL_H
+#define MESA_MOCO_DRI3_PROTOCOL_H
+
+#include <stdint.h>
+
+#define COPRESENT_VERSION        1u
+#define COPRESENT_LOCAL_PATH     "/run/moco-present.sock"
+
+enum copresent_opcode {
+   COPRESENT_BIND    = 1,
+   COPRESENT_PRESENT = 2,
+   COPRESENT_UNBIND  = 3,
+
+   COPRESENT_BOUND   = 0x101,
+   COPRESENT_RELEASE = 0x102,
+   COPRESENT_UNBOUND = 0x103,
+   COPRESENT_ERROR   = 0x1ff
+};
+
+enum copresent_status {
+   COPRESENT_OK             = 0,
+   COPRESENT_BAD_RECORD     = 1,
+   COPRESENT_NO_RESOURCE    = 2,
+   COPRESENT_NO_WINDOW      = 3,
+   COPRESENT_STALE          = 4,
+   COPRESENT_PRESENT_FAILED = 5
+};
+
+#define COPRESENT_F_Y_0_TOP      (1u << 1)
+
+struct copresent_record {
+   uint32_t opcode;
+   uint32_t version;
+   uint32_t generation;
+   uint32_t connection;
+   uint32_t buffer;
+   uint32_t serial;
+   uint32_t xid;
+   uint32_t resource_id;
+   uint32_t width;
+   uint32_t height;
+   uint32_t damage_x;
+   uint32_t damage_y;
+   uint32_t damage_width;
+   uint32_t damage_height;
+   uint32_t flags;
+   uint32_t status;
+};
+
+typedef char copresent_record_size_check[
+   (sizeof(struct copresent_record) == 64) ? 1 : -1];
+
+#endif
