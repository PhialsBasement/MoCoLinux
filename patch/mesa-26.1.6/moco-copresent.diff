diff --color -ruN '--exclude=__pycache__' '--exclude=.moco-copresent-patch-sha256' '--exclude=build*' a/src/gallium/frontends/dri/moco_dri3.c b/src/gallium/frontends/dri/moco_dri3.c
--- a/src/gallium/frontends/dri/moco_dri3.c	1970-01-01 10:00:00.000000000 +1000
+++ b/src/gallium/frontends/dri/moco_dri3.c	2026-08-10 01:48:47.458863200 +1000
@@ -0,0 +1,84 @@
+/*
+ * CoPresent transport for Mesa's normal DRI3 loader.
+ *
+ * Mesa still allocates DRI images, tracks buffer age, produces fences and
+ * performs all normal GLX/EGL drawable bookkeeping. Only the final operation
+ * a Linux X server would perform is replaced: instead of handing a dma-buf to
+ * the server, the client emits a presentation command into the virgl stream
+ * it is already rendering through, and the host -- which already owns that
+ * texture -- shows it.
+ *
+ * Everything the earlier revision needed (a Unix socket, a root-only broker,
+ * a pinned metadata ring, dma-buf export and PRIME import) is gone. Those
+ * were invisible to sandboxed clients: Firefox's content processes and
+ * Steam's pressure-vessel container cannot see /run, so presentation silently
+ * fell back to software there. A render node is the one thing every sandbox
+ * that renders must already have, so presentation now needs nothing else.
+ */
+
+#include "moco_dri3.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct moco_dri3_present {
+   uint32_t xid;
+   bool announced;
+};
+
+struct moco_dri3_present *
+moco_dri3_present_create(xcb_connection_t *conn, uint32_t xid)
+{
+   struct moco_dri3_present *present = calloc(1, sizeof(*present));
+
+   if (!present)
+      return NULL;
+   present->xid = xid;
+
+   /* The host matches XIDs against the property the Windows X server puts on
+    * TOP-LEVEL windows only. Toolkit clients (Firefox, GTK/Qt, Steam) render
+    * into a child of their top-level, so the drawable's own XID matches
+    * nothing host-side. Walk the ancestor chain once, here. */
+   if (conn) {
+      uint32_t walk = xid;
+
+      for (int depth = 0; depth < 32; depth++) {
+         xcb_query_tree_cookie_t cookie = xcb_query_tree(conn, walk);
+         xcb_query_tree_reply_t *reply =
+            xcb_query_tree_reply(conn, cookie, NULL);
+
+         if (!reply)
+            break;
+         if (reply->parent == XCB_NONE || reply->parent == reply->root) {
+            present->xid = walk;
+            free(reply);
+            break;
+         }
+         walk = reply->parent;
+         free(reply);
+      }
+   }
+   return present;
+}
+
+uint32_t
+moco_dri3_present_xid(struct moco_dri3_present *present)
+{
+   return present ? present->xid : 0;
+}
+
+bool
+moco_dri3_present_announce(struct moco_dri3_present *present)
+{
+   if (!present || present->announced)
+      return false;
+   present->announced = true;
+   return true;
+}
+
+void
+moco_dri3_present_destroy(struct moco_dri3_present *present)
+{
+   free(present);
+}
