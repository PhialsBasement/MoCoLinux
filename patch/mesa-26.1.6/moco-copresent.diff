diff --color -ruN '--exclude=__pycache__' '--exclude=.moco-copresent-patch-sha256' '--exclude=build-moco' a/src/gallium/frontends/dri/moco_dri3.c b/src/gallium/frontends/dri/moco_dri3.c
--- a/src/gallium/frontends/dri/moco_dri3.c	1970-01-01 10:00:00.000000000 +1000
+++ b/src/gallium/frontends/dri/moco_dri3.c	2026-08-09 23:00:21.812346900 +1000
@@ -0,0 +1,306 @@
+/*
+ * CoPresent transport for Mesa's normal DRI3 loader.
+ *
+ * Mesa still allocates DRI images, exports dma-bufs, produces native fences,
+ * tracks buffer age and performs all normal GLX drawable bookkeeping.  This
+ * file replaces only the operation a Linux X server normally performs at the
+ * end: importing the dma-buf and presenting it.  Stock VcXsrv remains the X
+ * control plane and never receives a Linux file descriptor.
+ */
+
+#include "moco_dri3.h"
+#include "moco_dri3_protocol.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+#define MOCO_DRI3_MAX_BUFFERS 16
+#define MOCO_DRI3_RETRY_NS    1000000000ULL
+
+struct moco_dri3_binding {
+   uint32_t id;
+   bool active;
+   bool bound;
+};
+
+struct moco_dri3_present {
+   int socket_fd;
+   uint32_t xid;
+   uint32_t serial;
+   uint64_t retry_after_ns;
+   bool direct_announced;
+   bool fallback_announced;
+   struct moco_dri3_binding bindings[MOCO_DRI3_MAX_BUFFERS];
+};
+
+static uint64_t
+monotonic_ns(void)
+{
+   struct timespec now;
+
+   clock_gettime(CLOCK_MONOTONIC, &now);
+   return (uint64_t)now.tv_sec * 1000000000ULL + (uint64_t)now.tv_nsec;
+}
+
+static int
+connect_broker(void)
+{
+   struct sockaddr_un address;
+   int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+
+   if (fd < 0)
+      return -1;
+   memset(&address, 0, sizeof(address));
+   address.sun_family = AF_UNIX;
+   snprintf(address.sun_path, sizeof(address.sun_path), "%s",
+            COPRESENT_LOCAL_PATH);
+   if (connect(fd, (struct sockaddr *)&address, sizeof(address)) != 0) {
+      close(fd);
+      return -1;
+   }
+   return fd;
+}
+
+static int
+send_record_fd(int socket_fd, const struct copresent_record *record,
+               int passed_fd)
+{
+   struct iovec iov = {
+      .iov_base = (void *)record,
+      .iov_len = sizeof(*record),
+   };
+   char control[CMSG_SPACE(sizeof(int))];
+   struct msghdr message;
+
+   memset(&message, 0, sizeof(message));
+   message.msg_iov = &iov;
+   message.msg_iovlen = 1;
+   if (passed_fd >= 0) {
+      struct cmsghdr *cmsg;
+
+      memset(control, 0, sizeof(control));
+      message.msg_control = control;
+      message.msg_controllen = sizeof(control);
+      cmsg = CMSG_FIRSTHDR(&message);
+      cmsg->cmsg_level = SOL_SOCKET;
+      cmsg->cmsg_type = SCM_RIGHTS;
+      cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+      memcpy(CMSG_DATA(cmsg), &passed_fd, sizeof(passed_fd));
+   }
+
+   return sendmsg(socket_fd, &message, MSG_NOSIGNAL) == sizeof(*record) ?
+          0 : -1;
+}
+
+static int
+wait_for_response(struct moco_dri3_present *present, uint32_t opcode,
+                  uint32_t buffer)
+{
+   for (;;) {
+      struct copresent_record response;
+      ssize_t got = recv(present->socket_fd, &response, sizeof(response), 0);
+
+      if (got != sizeof(response) || response.version != COPRESENT_VERSION)
+         return -1;
+      if (response.buffer != buffer)
+         continue;
+      if (response.opcode == COPRESENT_ERROR)
+         return -1;
+      if (response.opcode == opcode)
+         return response.status == COPRESENT_OK ? 0 : -1;
+   }
+}
+
+static void
+disconnect_broker(struct moco_dri3_present *present)
+{
+   unsigned i;
+
+   if (present->socket_fd >= 0)
+      close(present->socket_fd);
+   present->socket_fd = -1;
+   present->retry_after_ns = monotonic_ns() + MOCO_DRI3_RETRY_NS;
+   for (i = 0; i < MOCO_DRI3_MAX_BUFFERS; i++)
+      present->bindings[i].bound = false;
+}
+
+static int
+ensure_connected(struct moco_dri3_present *present)
+{
+   uint64_t now;
+
+   if (present->socket_fd >= 0)
+      return 0;
+   now = monotonic_ns();
+   if (now < present->retry_after_ns)
+      return -1;
+
+   present->socket_fd = connect_broker();
+   if (present->socket_fd < 0) {
+      present->retry_after_ns = now + MOCO_DRI3_RETRY_NS;
+      if (!present->fallback_announced) {
+         fprintf(stderr,
+                 "MoCo DRI3: CoPresent unavailable for XID 0x%x; using X fallback\n",
+                 present->xid);
+         present->fallback_announced = true;
+      }
+      return -1;
+   }
+   return 0;
+}
+
+static struct moco_dri3_binding *
+find_binding(struct moco_dri3_present *present, uint32_t id, bool allocate)
+{
+   struct moco_dri3_binding *free_binding = NULL;
+   unsigned i;
+
+   for (i = 0; i < MOCO_DRI3_MAX_BUFFERS; i++) {
+      struct moco_dri3_binding *binding = &present->bindings[i];
+
+      if (binding->active && binding->id == id)
+         return binding;
+      if (!binding->active && !free_binding)
+         free_binding = binding;
+   }
+   if (!allocate || !free_binding)
+      return NULL;
+   free_binding->active = true;
+   free_binding->id = id;
+   return free_binding;
+}
+
+static int
+bind_buffer(struct moco_dri3_present *present,
+            struct moco_dri3_binding *binding, int dma_fd,
+            uint32_t width, uint32_t height)
+{
+   struct copresent_record record;
+
+   memset(&record, 0, sizeof(record));
+   record.opcode = COPRESENT_BIND;
+   record.version = COPRESENT_VERSION;
+   record.buffer = binding->id;
+   record.xid = present->xid;
+   record.width = width;
+   record.height = height;
+   if (send_record_fd(present->socket_fd, &record, dma_fd) != 0 ||
+       wait_for_response(present, COPRESENT_BOUND, binding->id) != 0)
+      return -1;
+   binding->bound = true;
+   return 0;
+}
+
+struct moco_dri3_present *
+moco_dri3_present_create(uint32_t xid)
+{
+   struct moco_dri3_present *present = calloc(1, sizeof(*present));
+
+   if (!present)
+      return NULL;
+   present->socket_fd = -1;
+   present->xid = xid;
+   return present;
+}
+
+bool
+moco_dri3_present_frame(struct moco_dri3_present *present,
+                        uint32_t buffer, int dma_fd, int fence_fd,
+                        uint32_t width, uint32_t height,
+                        uint32_t damage_x, uint32_t damage_y,
+                        uint32_t damage_width, uint32_t damage_height)
+{
+   struct moco_dri3_binding *binding;
+   struct copresent_record record;
+
+   if (!present || dma_fd < 0 || fence_fd < 0 || width == 0 || height == 0 ||
+       ensure_connected(present) != 0)
+      return false;
+
+   binding = find_binding(present, buffer, true);
+   if (!binding ||
+       (!binding->bound && bind_buffer(present, binding, dma_fd,
+                                       width, height) != 0))
+      goto fail;
+
+   memset(&record, 0, sizeof(record));
+   record.opcode = COPRESENT_PRESENT;
+   record.version = COPRESENT_VERSION;
+   record.buffer = buffer;
+   record.serial = ++present->serial;
+   record.width = width;
+   record.height = height;
+   record.damage_x = damage_x;
+   record.damage_y = damage_y;
+   record.damage_width = damage_width;
+   record.damage_height = damage_height;
+   record.flags = COPRESENT_F_Y_0_TOP;
+   if (send_record_fd(present->socket_fd, &record, fence_fd) != 0 ||
+       wait_for_response(present, COPRESENT_RELEASE, buffer) != 0)
+      goto fail;
+
+   if (!present->direct_announced || present->fallback_announced) {
+      fprintf(stderr,
+              "MoCo DRI3: direct virgl/CoPresent active for XID 0x%x\n",
+              present->xid);
+      present->direct_announced = true;
+      present->fallback_announced = false;
+   }
+   return true;
+
+fail:
+   disconnect_broker(present);
+   if (!present->fallback_announced) {
+      fprintf(stderr,
+              "MoCo DRI3: presenter lost for XID 0x%x; using X fallback\n",
+              present->xid);
+      present->fallback_announced = true;
+   }
+   return false;
+}
+
+void
+moco_dri3_present_unbind(struct moco_dri3_present *present, uint32_t buffer)
+{
+   struct moco_dri3_binding *binding;
+
+   if (!present)
+      return;
+   binding = find_binding(present, buffer, false);
+   if (!binding)
+      return;
+
+   if (binding->bound && present->socket_fd >= 0) {
+      struct copresent_record record;
+
+      memset(&record, 0, sizeof(record));
+      record.opcode = COPRESENT_UNBIND;
+      record.version = COPRESENT_VERSION;
+      record.buffer = buffer;
+      if (send_record_fd(present->socket_fd, &record, -1) != 0 ||
+          wait_for_response(present, COPRESENT_UNBOUND, buffer) != 0)
+         disconnect_broker(present);
+   }
+   memset(binding, 0, sizeof(*binding));
+}
+
+void
+moco_dri3_present_destroy(struct moco_dri3_present *present)
+{
+   unsigned i;
+
+   if (!present)
+      return;
+   for (i = 0; i < MOCO_DRI3_MAX_BUFFERS; i++)
+      if (present->bindings[i].active)
+         moco_dri3_present_unbind(present, present->bindings[i].id);
+   if (present->socket_fd >= 0)
+      close(present->socket_fd);
+   free(present);
+}
