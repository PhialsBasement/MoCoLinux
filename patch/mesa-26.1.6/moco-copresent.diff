+/*
+ * Compatibility path used only while CoPresent is unavailable.  The normal
+ * path never maps a frame.  Keeping this here, next to Mesa's DRI image, lets
+ * a running application expose the ordinary VcXsrv drawable immediately
+ * after the host overlay is torn down instead of remaining black forever.
+ */
+static bool
+moco_xput_image(struct loader_dri3_drawable *draw,
+                struct loader_dri3_buffer *buffer,
+                xcb_drawable_t target)
+{
+   struct dri_context *ctx = draw->vtable->get_dri_context(draw);
+   const unsigned target_bytes = 240 * 1024;
+   unsigned width, height, row_bytes, rows_per_request, y;
+   void *map_data = NULL;
+   unsigned char *packed = NULL;
+   void *map;
+   int stride;
+
+   if (!ctx || !buffer || !buffer->image || !buffer->cpp ||
+       draw->width <= 0 || draw->height <= 0)
+      return false;
+
+   width = MIN2((unsigned)draw->width, buffer->width);
+   height = MIN2((unsigned)draw->height, buffer->height);
+
+   map = dri2_map_image(ctx, buffer->image, 0, 0,
+                        width, height,
+                        __DRI_IMAGE_TRANSFER_READ, &stride, &map_data);
+   if (!map)
+      return false;
+
+   row_bytes = ALIGN_POT(width * buffer->cpp, 4);
+   rows_per_request = MAX2(1, target_bytes / row_bytes);
+   packed = malloc((size_t)row_bytes * rows_per_request);
+   if (!packed) {
+      dri2_unmap_image(ctx, buffer->image, map_data);
+      return false;
+   }
+
+   for (y = 0; y < height; y += rows_per_request) {
+      unsigned rows = MIN2(rows_per_request, height - y);
+      unsigned line;
+
+      for (line = 0; line < rows; line++) {
+         memcpy(packed + (size_t)line * row_bytes,
+                (const unsigned char *)map + (ptrdiff_t)(y + line) * stride,
+                (size_t)width * buffer->cpp);
+         if (row_bytes > width * buffer->cpp)
+            memset(packed + (size_t)line * row_bytes +
+                   (size_t)width * buffer->cpp, 0,
+                   row_bytes - width * buffer->cpp);
+      }
+
+      xcb_put_image(draw->conn, XCB_IMAGE_FORMAT_Z_PIXMAP,
+                    target, dri3_drawable_gc(draw),
+                    width, rows, 0, y, 0, draw->depth,
+                    row_bytes * rows, packed);
+   }
+   xcb_flush(draw->conn);
+   free(packed);
+   dri2_unmap_image(ctx, buffer->image, map_data);
+   return true;
+}
+
+/* glXWaitX is the inverse, infrequent interoperability operation: copy
+ * ordinary X drawing into Mesa's private front image.  It is deliberately a
+ * CPU path because VcXsrv owns that source; direct GL frames never pass here. */
+static bool
+moco_xget_image(struct loader_dri3_drawable *draw,
+                struct loader_dri3_buffer *buffer,
+                xcb_drawable_t source)
+{
+   struct dri_context *ctx = draw->vtable->get_dri_context(draw);
+   xcb_get_image_cookie_t cookie;
+   xcb_get_image_reply_t *reply;
+   xcb_generic_error_t *error = NULL;
+   void *map_data = NULL;
+   unsigned char *map;
+   const unsigned char *pixels;
+   unsigned width, height, source_stride, row_bytes;
+   int map_stride;
+
+   if (!ctx || !buffer || !buffer->image || !buffer->cpp)
+      return false;
+
+   width = MIN2((unsigned)MAX2(draw->width, 0), buffer->width);
+   height = MIN2((unsigned)MAX2(draw->height, 0), buffer->height);
+   if (!width || !height)
+      return false;
+
+   cookie = xcb_get_image(draw->conn, XCB_IMAGE_FORMAT_Z_PIXMAP, source,
+                          0, 0, width, height, UINT32_MAX);
+   reply = xcb_get_image_reply(draw->conn, cookie, &error);
+   if (!reply || error) {
+      free(error);
+      free(reply);
+      return false;
+   }
+
+   pixels = xcb_get_image_data(reply);
+   source_stride = xcb_get_image_data_length(reply) / height;
+   row_bytes = width * buffer->cpp;
+   if (source_stride < row_bytes) {
+      free(reply);
+      return false;
+   }
+
+   map = dri2_map_image(ctx, buffer->image, 0, 0, width, height,
+                        __DRI_IMAGE_TRANSFER_WRITE, &map_stride, &map_data);
+   if (!map) {
+      free(reply);
+      return false;
+   }
+
+   for (unsigned y = 0; y < height; y++)
+      memcpy(map + (ptrdiff_t)y * map_stride,
+             pixels + (size_t)y * source_stride, row_bytes);
+
+   dri2_unmap_image(ctx, buffer->image, map_data);
+   free(reply);
+   return true;
+}
+
+static bool
+moco_present_buffer(struct loader_dri3_drawable *draw,
+                    struct loader_dri3_buffer *buffer,
+                    const int *rects, int n_rects)
+{
+   struct dri_context *ctx = draw->vtable->get_dri_context(draw);
+   uint32_t damage_x = 0, damage_y = 0;
+   uint32_t damage_width = buffer->width;
+   uint32_t damage_height = buffer->height;
+   void *fence = NULL;
+   int fence_fd = -1;
+   bool presented = false;
+
+   if (n_rects > 0 && rects) {
+      int min_x = buffer->width;
+      int min_y = buffer->height;
+      int max_x = 0;
+      int max_y = 0;
+
+      for (int i = 0; i < n_rects; i++) {
+         const int *rect = &rects[i * 4];
+         int x0 = CLAMP(rect[0], 0, (int)buffer->width);
+         int y0 = CLAMP((int)buffer->height - rect[1] - rect[3],
+                        0, (int)buffer->height);
+         int x1 = CLAMP(rect[0] + rect[2], 0, (int)buffer->width);
+         int y1 = CLAMP(y0 + rect[3], 0, (int)buffer->height);
+
+         min_x = MIN2(min_x, x0);
+         min_y = MIN2(min_y, y0);
+         max_x = MAX2(max_x, x1);
+         max_y = MAX2(max_y, y1);
+      }
+      if (max_x > min_x && max_y > min_y) {
+         damage_x = min_x;
+         damage_y = min_y;
+         damage_width = max_x - min_x;
+         damage_height = max_y - min_y;
+      }
+   }
+
+   if (ctx) {
+      fence = dri_create_fence_fd(ctx, -1);
+      if (fence)
+         fence_fd = dri_get_fence_fd(draw->dri_screen_render_gpu, fence);
+   }
+   if (fence_fd >= 0)
+      presented = moco_dri3_present_frame(draw->moco_present,
+                                          buffer->pixmap,
+                                          buffer->moco_dma_fd, fence_fd,
+                                          buffer->width, buffer->height,
+                                          damage_x, damage_y,
+                                          damage_width, damage_height);
+   if (fence_fd >= 0)
+      close(fence_fd);
+   if (fence)
+      dri_destroy_fence(draw->dri_screen_render_gpu, fence);
+
+   if (!presented)
+      return moco_xput_image(draw, buffer, draw->drawable);
+   return true;
+}
