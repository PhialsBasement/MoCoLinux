+/*
+ * MoCoLinux CoPresent: ask the host to show this resource in an X window.
+ *
+ * Deliberately just another command in the rendering stream. It travels down
+ * the render node the application already has open, so a sandboxed client --
+ * a browser content process, a Steam game inside pressure-vessel -- needs no
+ * socket, no additional device and no filesystem share to present. Ordering
+ * comes for free: this lands after the draws it presents, in the same buffer.
+ *
+ * Called from the DRI3 loader (moco_dri3.c), which is why it takes plain
+ * pipe types rather than virgl ones.
+ */
+void virgl_moco_encode_present(struct pipe_context *pctx,
+                               struct pipe_resource *pres,
+                               uint32_t xid,
+                               uint32_t width, uint32_t height,
+                               uint32_t damage_x, uint32_t damage_y,
+                               uint32_t damage_width, uint32_t damage_height)
+{
+   struct virgl_context *ctx;
+   struct virgl_resource *res;
+
+   if (!pctx || !pres)
+      return;
+   ctx = virgl_context(pctx);
+   res = virgl_resource(pres);
+
+   virgl_encoder_write_cmd_dword(ctx, VIRGL_CMD0(VIRGL_CCMD_MOCO_PRESENT, 0,
+                                                 VIRGL_MOCO_PRESENT_SIZE));
+   /* write_res also records the reference, so the host keeps the resource
+    * attached to this context for the lifetime of the command buffer. */
+   virgl_encoder_write_res(ctx, res);
+   virgl_encoder_write_dword(ctx->cbuf, xid);
+   virgl_encoder_write_dword(ctx->cbuf, width);
+   virgl_encoder_write_dword(ctx->cbuf, height);
+   virgl_encoder_write_dword(ctx->cbuf, damage_x);
+   virgl_encoder_write_dword(ctx->cbuf, damage_y);
+   virgl_encoder_write_dword(ctx->cbuf, damage_width);
+   virgl_encoder_write_dword(ctx->cbuf, damage_height);
+
+   /* A frame the user is waiting to see must not sit in the command buffer
+    * until something else happens to flush it. */
+   pctx->flush(pctx, NULL, PIPE_FLUSH_END_OF_FRAME);
+}
