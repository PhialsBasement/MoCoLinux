+/* MoCo display-list cache reorder (used from compile_vertex_list).
+ *
+ * Expand merged GL_TRIANGLE_STRIP prims into an independent-triangle index
+ * list, preserving winding and dropping the degenerate bridge triangles the
+ * strip merge inserted.  Returns a malloc'd array whose [0] is the triangle
+ * count, followed by count*3 indices; NULL when nothing useful came out.
+ */
+static uint32_t *
+vbo_moco_expand_strips(const uint32_t *indices,
+                       const struct _mesa_prim *prims, unsigned prim_count,
+                       unsigned total_indices)
+{
+   uint32_t *out = malloc((1 + (size_t)total_indices * 3) * sizeof(uint32_t));
+   uint32_t n = 0;
+
+   if (!out)
+      return NULL;
+   for (unsigned p = 0; p < prim_count; p++) {
+      unsigned s = prims[p].start;
+      unsigned c = prims[p].count;
+
+      for (unsigned j = 0; j + 2 < c; j++) {
+         uint32_t a = indices[s + j];
+         uint32_t b = indices[s + j + 1];
+         uint32_t d = indices[s + j + 2];
+
+         if (a == b || b == d || a == d)
+            continue;              /* degenerate bridge */
+         if (j & 1) {
+            out[1 + n * 3 + 0] = b;
+            out[1 + n * 3 + 1] = a;
+         } else {
+            out[1 + n * 3 + 0] = a;
+            out[1 + n * 3 + 1] = b;
+         }
+         out[1 + n * 3 + 2] = d;
+         n++;
+      }
+   }
+   if (!n) {
+      free(out);
+      return NULL;
+   }
+   out[0] = n;
+   return out;
+}
+
+
+/* Tipsify (Sander, Nehab, Barczak 2007): linear-time triangle reorder for a
+ * FIFO post-transform cache.  Reorders whole triangles only; the indices
+ * inside each triangle -- and therefore winding -- are untouched.  The
+ * strip order this replaces revisits interior vertices one grid row apart,
+ * which busts the cache on any mesh wider than it; this brings shaded
+ * vertices per triangle back toward 1.
+ */
+static void
+vbo_moco_tipsify(uint32_t *tri_indices, uint32_t tri_count,
+                 uint32_t vertex_count)
+{
+   const uint32_t CACHE = 24;
+   uint32_t *adj_offset = calloc((size_t)vertex_count + 1, sizeof(uint32_t));
+   uint32_t *adj = malloc((size_t)tri_count * 3 * sizeof(uint32_t));
+   uint32_t *live = malloc((size_t)vertex_count * sizeof(uint32_t));
+   uint32_t *entered = calloc(vertex_count, sizeof(uint32_t));
+   uint8_t *emitted = calloc(tri_count, 1);
+   uint32_t *stack = malloc((size_t)tri_count * 3 * sizeof(uint32_t));
+   uint32_t *out = malloc((size_t)tri_count * 3 * sizeof(uint32_t));
+   uint32_t *cand = NULL;
+   uint32_t stack_top = 0, o = 0, timestamp = CACHE + 1, cursor = 0;
+   uint32_t max_degree = 0;
+   uint32_t f;
+
+   if (!adj_offset || !adj || !live || !entered || !emitted || !stack || !out)
+      goto cleanup;
+
+   for (uint32_t t = 0; t < tri_count; t++)
+      for (int k = 0; k < 3; k++)
+         adj_offset[tri_indices[t * 3 + k] + 1]++;
+   for (uint32_t v = 0; v < vertex_count; v++) {
+      if (adj_offset[v + 1] > max_degree)
+         max_degree = adj_offset[v + 1];
+      live[v] = adj_offset[v + 1];
+      adj_offset[v + 1] += adj_offset[v];
+   }
+   {
+      uint32_t *fill = malloc((size_t)vertex_count * sizeof(uint32_t));
+
+      if (!fill)
+         goto cleanup;
+      memcpy(fill, adj_offset, (size_t)vertex_count * sizeof(uint32_t));
+      for (uint32_t t = 0; t < tri_count; t++)
+         for (int k = 0; k < 3; k++)
+            adj[fill[tri_indices[t * 3 + k]]++] = t;
+      free(fill);
+   }
+
+   cand = malloc((size_t)max_degree * 3 * sizeof(uint32_t));
+   if (!cand)
+      goto cleanup;
+
+   f = tri_indices[0];
+   while (f != UINT32_MAX) {
+      uint32_t cand_count = 0;
+
+      for (uint32_t e = adj_offset[f]; e < adj_offset[f + 1]; e++) {
+         uint32_t t = adj[e];
+
+         if (emitted[t])
+            continue;
+         for (int k = 0; k < 3; k++) {
+            uint32_t v = tri_indices[t * 3 + k];
+
+            out[o++] = v;
+            stack[stack_top++] = v;
+            cand[cand_count++] = v;
+            live[v]--;
+            if (timestamp - entered[v] > CACHE)
+               entered[v] = timestamp++;
+         }
+         emitted[t] = 1;
+      }
+
+      f = UINT32_MAX;
+      {
+         int best = -1;
+
+         for (uint32_t c = 0; c < cand_count; c++) {
+            uint32_t v = cand[c];
+            int priority;
+
+            if (!live[v])
+               continue;
+            priority = 0;
+            if (timestamp - entered[v] + 2 * live[v] <= CACHE)
+               priority = (int)(timestamp - entered[v]);
+            if (priority > best) {
+               best = priority;
+               f = v;
+            }
+         }
+      }
+      if (f == UINT32_MAX) {
+         while (stack_top) {
+            uint32_t v = stack[--stack_top];
+
+            if (live[v]) {
+               f = v;
+               break;
+            }
+         }
+      }
+      if (f == UINT32_MAX) {
+         while (cursor < vertex_count) {
+            if (live[cursor]) {
+               f = cursor;
+               break;
+            }
+            cursor++;
+         }
+      }
+   }
+
+   if (o == tri_count * 3)
+      memcpy(tri_indices, out, (size_t)o * sizeof(uint32_t));
+
+cleanup:
+   free(adj_offset);
+   free(adj);
+   free(live);
+   free(entered);
+   free(emitted);
+   free(stack);
+   free(out);
+   free(cand);
+}
