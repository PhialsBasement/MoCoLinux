diff --color -ruN '--exclude=__pycache__' '--exclude=.moco-copresent-patch-sha256' '--exclude=build-moco' a/src/gallium/frontends/dri/moco_dri3_protocol.h b/src/gallium/frontends/dri/moco_dri3_protocol.h
--- a/src/gallium/frontends/dri/moco_dri3_protocol.h	1970-01-01 10:00:00.000000000 +1000
+++ b/src/gallium/frontends/dri/moco_dri3_protocol.h	2026-08-09 21:52:04.142436800 +1000
@@ -0,0 +1,57 @@
+/*
+ * MoCoLinux CoPresent wire ABI.  Keep this layout in sync with
+ * src/colinux/user/copresent/copresent.h in MoCoLinux.
+ */
+#ifndef MESA_MOCO_DRI3_PROTOCOL_H
+#define MESA_MOCO_DRI3_PROTOCOL_H
+
+#include <stdint.h>
+
+#define COPRESENT_VERSION        1u
+#define COPRESENT_LOCAL_PATH     "/run/moco-present.sock"
+
+enum copresent_opcode {
+   COPRESENT_BIND    = 1,
+   COPRESENT_PRESENT = 2,
+   COPRESENT_UNBIND  = 3,
+
+   COPRESENT_BOUND   = 0x101,
+   COPRESENT_RELEASE = 0x102,
+   COPRESENT_UNBOUND = 0x103,
+   COPRESENT_ERROR   = 0x1ff
+};
+
+enum copresent_status {
+   COPRESENT_OK             = 0,
+   COPRESENT_BAD_RECORD     = 1,
+   COPRESENT_NO_RESOURCE    = 2,
+   COPRESENT_NO_WINDOW      = 3,
+   COPRESENT_STALE          = 4,
+   COPRESENT_PRESENT_FAILED = 5
+};
+
+#define COPRESENT_F_Y_0_TOP      (1u << 1)
+
+struct copresent_record {
+   uint32_t opcode;
+   uint32_t version;
+   uint32_t generation;
+   uint32_t connection;
+   uint32_t buffer;
+   uint32_t serial;
+   uint32_t xid;
+   uint32_t resource_id;
+   uint32_t width;
+   uint32_t height;
+   uint32_t damage_x;
+   uint32_t damage_y;
+   uint32_t damage_width;
+   uint32_t damage_height;
+   uint32_t flags;
+   uint32_t status;
+};
+
+typedef char copresent_record_size_check[
+   (sizeof(struct copresent_record) == 64) ? 1 : -1];
+
+#endif
