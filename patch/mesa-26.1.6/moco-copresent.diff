+bool
+x11_dri3_is_moco(void)
+{
+   const char *selection = getenv("MOCO_DRI3");
+   static int cached = -1;
+   drmVersionPtr version;
+   bool is_virtio;
+   int fd;
+
+   if (selection && (!strcmp(selection, "0") ||
+                     !strcasecmp(selection, "false") ||
+                     !strcasecmp(selection, "off")))
+      return false;
+
+   if (cached >= 0)
+      return cached != 0;
+
+   /* Detect from the render node ALONE.
+    *
+    * This used to also require /run/moco-present.sock, back when
+    * presentation went through a broker socket. That made the whole stack
+    * invisible to any sandboxed process: Firefox's content processes and
+    * Steam's pressure-vessel container cannot see /run, so they silently
+    * fell back to software rendering while unsandboxed clients worked.
+    * Presentation now travels in the virgl command stream, so the render
+    * node the client is already allowed to open is the only thing that has
+    * to be true -- which is exactly what every sandbox already permits.
+    */
+   fd = open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
+   if (fd < 0) {
+      cached = 0;
+      return false;
+   }
+   version = drmGetVersion(fd);
+   is_virtio = version && version->name &&
+               !strcmp(version->name, "virtio_gpu");
+   if (version)
+      drmFreeVersion(version);
+   close(fd);
+
+   cached = is_virtio ? 1 : 0;
+   return is_virtio;
+}
