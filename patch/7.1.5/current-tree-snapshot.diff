diff -urN '--exclude=.*' '--exclude=*.o' '--exclude=*.cmd' '--exclude=*.ko' a/drivers/tty/hvc/hvc_colinux.c b/drivers/tty/hvc/hvc_colinux.c
--- a/drivers/tty/hvc/hvc_colinux.c	1970-01-01 10:00:00.000000000 +1000
+++ b/drivers/tty/hvc/hvc_colinux.c	2026-08-01 11:55:42.897917800 +1000
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * An interactive console for a cooperative Linux guest.
+ *
+ * The early console this port has had since the first boot is a one-way log:
+ * the guest appends bytes to a ring in the passage page and the host prints
+ * them when the run is over. That is the right instrument for finding out how
+ * far a boot got, and it is not a terminal -- nothing arrives from the other
+ * direction, and nothing appears until the guest has stopped.
+ *
+ * hvc is the natural shape for the real thing. It exists for exactly this
+ * situation, a console whose transport is a hypervisor rather than a UART, and
+ * it asks for two functions: put a buffer, get a buffer. Everything a terminal
+ * needs above that -- the tty, line discipline, job control, /dev/hvc0 -- is
+ * the hvc core's, already written and already correct.
+ *
+ * There is no interrupt to register, so hvc polls from its own kthread. That
+ * costs a wakeup every few milliseconds and needs nothing from the host, which
+ * suits a guest whose only clock is the one the host hands it at idle.
+ */
+
+#include <linux/console.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/moduleparam.h>
+#include <linux/types.h>
+
+#include "hvc_console.h"
+
+#define CO_CONSOLE_IN_SIZE	1024
+#define CO_CONSOLE_OUT_SIZE	4096
+
+struct co_console_io {
+	volatile unsigned int in_head;		/* host writes  */
+	volatile unsigned int in_tail;		/* guest writes */
+	volatile unsigned int out_head;		/* guest writes */
+	volatile unsigned int out_tail;		/* host writes  */
+	volatile char in[CO_CONSOLE_IN_SIZE];
+	volatile char out[CO_CONSOLE_OUT_SIZE];
+};
+
+extern struct co_console_io co_colinux_console_io;
+extern int co_colinux_guest;
+extern void co_colinux_yield(void);
+
+/*
+ * Bytes out.
+ *
+ * A short return tells hvc to come back with the rest, so a full ring is
+ * simply back-pressure rather than lost output -- but only while something is
+ * draining it. Nothing is: if no console client is attached the host never
+ * advances out_tail, and returning 0 forever would wedge every writer,
+ * including printk. So a completely undrained ring is treated as consumed,
+ * which loses the oldest output of an unwatched guest and keeps it running.
+ * The early console still has the boot log, and that is the thing worth
+ * keeping.
+ */
+static ssize_t hvc_co_put_chars(u32 vtermno, const u8 *buf, size_t count)
+{
+	struct co_console_io *io = &co_colinux_console_io;
+	unsigned int head = io->out_head;
+	unsigned int tail = io->out_tail;
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		if (head - tail >= CO_CONSOLE_OUT_SIZE)
+			break;
+		io->out[head & (CO_CONSOLE_OUT_SIZE - 1)] = buf[i];
+		head++;
+	}
+
+	/*
+	 * The bytes must be visible before the host is told they are there,
+	 * and the host may look at any moment from another processor.
+	 */
+	smp_wmb();
+	io->out_head = head;
+
+	/*
+	 * Hand the host the CPU so it can drain promptly. Without this the
+	 * output sits in the ring until the guest happens to cross for some
+	 * other reason, which at a shell prompt could be a long time -- the
+	 * guest is idle precisely when it has just finished printing.
+	 */
+	if (co_colinux_guest)
+		co_colinux_yield();
+
+	return i ? (ssize_t)i : (ssize_t)count;
+}
+
+static ssize_t hvc_co_get_chars(u32 vtermno, u8 *buf, size_t count)
+{
+	struct co_console_io *io = &co_colinux_console_io;
+	unsigned int tail = io->in_tail;
+	size_t i = 0;
+
+	while (i < count && tail != io->in_head) {
+		/* the byte was written before in_head advanced */
+		smp_rmb();
+		buf[i++] = io->in[tail & (CO_CONSOLE_IN_SIZE - 1)];
+		tail++;
+	}
+
+	io->in_tail = tail;
+
+	return i;
+}
+
+static const struct hv_ops hvc_co_ops = {
+	.get_chars = hvc_co_get_chars,
+	.put_chars = hvc_co_put_chars,
+};
+
+/*
+ * Claimed early so that console=hvc0 on the command line resolves, which has
+ * to happen before the tty layer exists.
+ */
+static int __init hvc_co_console_init(void)
+{
+	if (!co_colinux_guest)
+		return 0;
+
+	return hvc_instantiate(0, 0, &hvc_co_ops);
+}
+console_initcall(hvc_co_console_init);
+
+static int __init hvc_co_init(void)
+{
+	struct hvc_struct *hp;
+
+	if (!co_colinux_guest)
+		return 0;
+
+	/* no interrupt: hvc polls, which is all this transport can offer */
+	hp = hvc_alloc(0, 0, &hvc_co_ops, 128);
+	if (IS_ERR(hp))
+		return PTR_ERR(hp);
+
+	return 0;
+}
+device_initcall(hvc_co_init);
