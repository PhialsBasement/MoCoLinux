+DEFINE_IDTENTRY_SYSVEC(sysvec_co_timer)
+{
+	struct pt_regs *old = set_irq_regs(regs);
+	unsigned int n;
+
+	/*
+	 * Posted vectors first, and this is the important one of the three
+	 * drain points.
+	 *
+	 * Idle and return-to-userspace both require the target to be doing
+	 * something in particular. A processor running a kernel thread is
+	 * doing neither, and the sender of a cross-processor call is spinning
+	 * in csd_lock_wait() until the target answers -- on_each_cpu() is what
+	 * every text_poke does, which is every static-key flip, which includes
+	 * the one sched_cpu_activate() performs during bring-up itself.
+	 *
+	 * This is a stock idtentry, so irq_enter_rcu() has already run and RCU
+	 * is watching. That is what makes it a legal place to run
+	 * sched_ttwu_pending() and the call-function handlers, and it is why
+	 * the drain does not belong in co_colinux_switch() or
+	 * co_colinux_yield(): both of those are reached with rq->lock held.
+	 */
+	co_colinux_ipi_drain();
+
+	n = co_colinux_take_ticks();
+
+	{
+		struct clock_event_device *evt =
+			&co_colinux_clockevent[co_colinux_vcpu_id()];
+
+		while (n--)
+			evt->event_handler(evt);
+	}
+
+	co_colinux_drain_devices();
+
+	set_irq_regs(old);
+}
+
+void co_colinux_drain_time(void)
+{
+	struct pt_regs *old, regs;
+	unsigned int n;
+
+	n = co_colinux_take_ticks();
+	if (!n) {
+		/*
+		 * Reap block completions even when no tick is due: a task
+		 * sleeping on a read drove the guest to idle, and this is the
+		 * boundary where its I/O comes back and wakes it.
+		 */
+		co_colinux_drain_devices();
+		return;
+	}
+
+	/*
+	 * A register frame for the tick to look at.
+	 *
+	 * tick_periodic() asks user_mode(get_irq_regs()) whether the tick
+	 * interrupted userspace, and profile_tick() wants the interrupted RIP.
+	 * On real hardware the interrupt entry path fills that pointer in;
+	 * these ticks have no entry path, so it stays NULL and user_mode()
+	 * dereferences it -- a fault at NULL + 0x88, which is where cs sits in
+	 * struct pt_regs, and exactly what the first run of this code did.
+	 *
+	 * The honest answer is kernel mode: ticks are drained at the idle
+	 * boundary, so the guest was in co_cpu_idle when time passed, never in
+	 * userspace. Time is therefore accounted to the idle task, which is
+	 * what actually consumed it.
+	 */
+	memset(&regs, 0, sizeof(regs));
+	regs.cs	   = __KERNEL_CS;
+	regs.ss	   = __KERNEL_DS;
+	regs.ip	   = _THIS_IP_;
+	regs.sp	   = (unsigned long)&regs;
+
+	irq_enter();
+	old = set_irq_regs(&regs);
+	{
+		struct clock_event_device *evt =
+			&co_colinux_clockevent[co_colinux_vcpu_id()];
+
+		while (n--)
+			evt->event_handler(evt);
+	}
+	co_colinux_drain_devices();
+	set_irq_regs(old);
+	irq_exit();
+}
