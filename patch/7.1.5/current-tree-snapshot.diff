+static struct clock_event_device co_colinux_clockevent = {
+	.name			= "cotimer",
+	.features		= CLOCK_EVT_FEAT_PERIODIC,
+	.set_state_periodic	= co_colinux_ce_state_noop,
+	.set_state_shutdown	= co_colinux_ce_state_noop,
+	.rating			= 300,
+};
