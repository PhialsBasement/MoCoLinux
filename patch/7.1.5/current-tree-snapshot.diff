+#ifdef CONFIG_SMP
+/*
+ * Sending, without an interrupt controller in the path.
+ *
+ * The natives already reach co_colinux_ipi_send() through the inert apic's
+ * .send_IPI hooks, so these are not strictly required -- but
+ * native_send_call_func_ipi() takes the apic_use_ipi_shorthand branch and calls
+ * __apic_send_IPI_all(), and co_apic_send_IPI_all() iterates cpu_online_mask
+ * INCLUDING the sender. Every on_each_cpu() then posts a vector to this
+ * processor and rings this processor's own doorbell, leaving its idle event
+ * signalled and costing it one spurious re-entry. Going straight to the
+ * doorbell removes the shorthand and one layer of static calls with it.
+ */
+static void co_colinux_send_reschedule(int cpu)
+{
+	co_colinux_ipi_send(cpu, RESCHEDULE_VECTOR);
+}
+
+static void co_colinux_send_call_func_single_ipi(int cpu)
+{
+	co_colinux_ipi_send(cpu, CALL_FUNCTION_SINGLE_VECTOR);
+}
+
+static void co_colinux_send_call_func_ipi(const struct cpumask *mask)
+{
+	unsigned int cpu;
+
+	for_each_cpu(cpu, mask)
+		co_colinux_ipi_send(cpu, CALL_FUNCTION_VECTOR);
+}
+
+/*
+ * Where a cooperative processor goes to stop.
+ *
+ * Not stop_this_cpu(): it ends in native_halt(), which in this port emits the
+ * ud2 pair the host reads as "the guest has halted" -- so one secondary going
+ * offline would tell the host the whole machine died. And not a spin either:
+ * this thread still holds a host processor, and a processor held under a spin
+ * is a processor Windows does not get its clock on.
+ *
+ * Off the online mask first, so nothing new is aimed here, then idle forever --
+ * which is exactly what the host wants of a vCPU with no work to do.
+ */
+void __noreturn co_colinux_stop_this_cpu(void);
+
+void __noreturn co_colinux_stop_this_cpu(void)
+{
+	local_irq_disable();
+	set_cpu_online(smp_processor_id(), false);
+
+	for (;;)
+		co_colinux_switch_op(2 /* CO_OPERATION_IDLE */);
+}
+
+/*
+ * native_stop_other_cpus() cannot be used here, and the failure is a hang
+ * rather than a misbehaviour.
+ *
+ * It sends REBOOT_VECTOR, waits a second, then sends NMI_VECTOR and waits
+ * again -- and when the caller is stop_other_cpus() (wait = 1, which is what
+ * machine_shutdown() uses) the second wait has no timeout at all:
+ *
+ *	while (!cpumask_empty(&cpus_stop_mask) && (wait || timeout--))
+ *
+ * Neither vector reaches a handler through the shared-memory doorbell, so
+ * cpus_stop_mask never empties and every reboot and every poweroff stands
+ * there forever. It also calls disable_local_APIC() on a chip that is the
+ * host's.
+ *
+ * The cooperative version is the doorbell and a bounded wait. A vCPU that does
+ * not answer is a vCPU whose host thread has already left the driver, which is
+ * not a reason for this one to stand still.
+ */
+static void co_colinux_stop_other_cpus(int wait)
+{
+	unsigned int cpu, self = smp_processor_id();
+	int ms;
+
+	for_each_online_cpu(cpu)
+		if (cpu != self)
+			co_colinux_ipi_send(cpu, REBOOT_VECTOR);
+
+	for (ms = 0; ms < 500 && num_online_cpus() > 1; ms++)
+		mdelay(1);
+
+	if (num_online_cpus() > 1)
+		pr_warn("colinux: %u processor(s) did not stop\n",
+			num_online_cpus() - 1);
+}
+
+/*
+ * Offlining. native_cpu_disable() calls lapic_can_unplug_cpu() and
+ * apic_soft_disable() -- both about a chip this guest does not own. The
+ * generic half, which moves timers, interrupts and tasks off this processor,
+ * is all that applies.
+ */
+static int co_colinux_cpu_disable(void)
+{
+	cpu_disable_common();
+	return 0;
+}
+
+static void __noreturn co_colinux_play_dead(void)
+{
+	co_colinux_stop_this_cpu();
+}
+#endif /* CONFIG_SMP */
+
+static void __init co_colinux_smp_prepare_cpus(unsigned int max_cpus)
+{
+	smp_prepare_cpus_common();
+
+	pr_info("colinux: %u processor(s) possible; the host starts them, "
+		"not INIT-SIPI\n", num_possible_cpus());
+
+	/*
+	 * The spin-loop probe is NOT called here, and must never be called in
+	 * a boot that also runs smp_init().
+	 *
+	 * co_colinux_ap_spin() never returns and never crosses back, so a
+	 * probe leaves vCPU 1's host thread inside the guest permanently. This
+	 * function runs immediately before smp_init(), so the very next thing
+	 * that happens is co_colinux_kick_ap(1) issuing START_VCPU at a thread
+	 * that is no longer waiting for it -- and the host then rewrites the
+	 * state of a vCPU that is currently executing from it.
+	 *
+	 * The plan's step A and step B were meant to be separate runs, gated
+	 * by a knob, not two things in one boot.
+	 */
+}
+
+/*
+ * Where a cooperative secondary begins.
+ *
+ * The host enters here through the world switch with the stack, address
+ * space and per-CPU base that co_colinux_kick_ap() chose, which is the state
+ * start_secondary() would have arrived with had there been a trampoline. What
+ * follows is start_secondary()'s work with the hardware steps removed: no
+ * APIC to bring online, no TSC sync against a processor that shares this
+ * one's clock, no microcode to load into a CPU the host already owns.
+ */
+/*
+ * Not __init: kick_ap_alive is a runtime smp_ops callback, so this address
+ * outlives free_initmem(). Bringing a CPU back online through sysfs after
+ * boot would otherwise enter freed and poisoned text on a processor that has
+ * no IDT yet. Xen's cpu_bringup_and_idle is deliberately not __init either.
+ */
+asmlinkage __visible void co_colinux_ap_start(void)
+{
+	unsigned int cpu;
+
+	/*
+	 * Nothing touches the descriptor tables before cpu_init().
+	 *
+	 * This processor arrives on the tables the host built into its passage
+	 * page -- a Linux-shaped GDT, a TSS with IST stacks, and an IDT of 256
+	 * host stubs -- all loaded by the world switch, and all valid. The
+	 * shim enables real interrupts before jumping here, so an interrupt
+	 * can arrive at any moment from the first instruction; landing it on a
+	 * host stub backed by the passage page's own IST is exactly what that
+	 * arrangement is for, and it is how the boot processor runs too.
+	 *
+	 * An earlier version called load_current_idt() here, reasoning that
+	 * the kernel's IDT should be in place before anything could fault.
+	 * That was backwards and reset the machine every time: it installs
+	 * handlers that expect this CPU's kernel TSS and IST stacks, which
+	 * cpu_init() below has not loaded yet, so the first interrupt
+	 * stack-switched through a TSS that was never there. The window it was
+	 * meant to close did not exist; the window it opened was fatal.
+	 */
+	cr4_init();
+	cpuhp_ap_sync_alive();
+
+	/*
+	 * The descriptor tables, in the order native does it -- and this port
+	 * is native on this axis, not Xen.
+	 *
+	 * Xen PV omits this because a PV guest has no IDT and no TSS of its
+	 * own: traps are registered with the hypervisor and ring transitions
+	 * use the hypervisor's kernel_ss/kernel_sp. This guest OWNS its IDT
+	 * (see co_colinux_adopt_traps), so a secondary that skips this runs
+	 * forever on the host's 256 stub gates with no #PF handler, with TR
+	 * still pointing at the host's passage-page TSS, with ist[] zero so
+	 * #DF stack-switches to zero -- and, worst, without
+	 * cr4_set_bits(X86_CR4_FSGSBASE).
+	 *
+	 * That last one is fatal and silent: alternatives were patched
+	 * globally long before this processor existed, so paranoid_entry here
+	 * is already RDGSBASE/WRGSBASE. Without the CR4 bit the first NMI or
+	 * #DB on this CPU executes an instruction the CPU will not permit,
+	 * takes #UD inside the entry path, and triples. No bugcheck, no dump.
+	 *
+	 * cpu_init_exception_handling() does the whole sequence in the one
+	 * order that works: setup_getcpu, tss_setup_ist, set_tss_desc,
+	 * load_TR_desc, the FSGSBASE bit, then load_current_idt. Calling
+	 * load_current_idt() alone -- as an earlier version here did --
+	 * installs handlers that need a TSS which has not been loaded yet,
+	 * which is why that attempt reset the machine every time.
+	 */
+	/*
+	 * CR4.FSGSBASE, and for now ONLY that.
+	 *
+	 * cpu_init_exception_handling() is what native calls here and what
+	 * this processor ultimately needs -- but it ends in
+	 * load_current_idt(), which replaces the host's 256 stub gates with
+	 * the kernel's. Those stubs are the only reason a fault on this
+	 * processor arrives as a report rather than a triple fault, and
+	 * everything after this line is still unproven. Take the one piece
+	 * that is fatal on its own and keep the reporting.
+	 *
+	 * Fatal on its own because alternatives were patched globally long
+	 * before this processor existed: paranoid_entry is already
+	 * RDGSBASE/WRGSBASE. Without the CR4 bit the first NMI or #DB here
+	 * executes an instruction the CPU refuses, takes #UD inside the entry
+	 * path, and triples -- with no bugcheck and nothing written, which is
+	 * the signature this bring-up has been producing.
+	 *
+	 * The rest of cpu_init_exception_handling -- setup_getcpu,
+	 * tss_setup_ist, set_tss_desc, load_TR_desc, load_current_idt -- goes
+	 * in with the desc.h redirection the plan calls for, so the writes
+	 * land in this vCPU's crossing-carried descriptor images instead of
+	 * on the hardware this thread shares with Windows.
+	 */
+	if (boot_cpu_has(X86_FEATURE_FSGSBASE))
+		cr4_set_bits(X86_CR4_FSGSBASE);
+
+	cpu = raw_smp_processor_id();
+
+	/*
+	 * Carry the live TSS descriptor across the GDT switch, BEFORE
+	 * cpu_init() makes this CPU's own GDT live.
+	 *
+	 * GDTR is still the passage page's ten-entry table, whose entry 8 is
+	 * a valid 64-bit TSS descriptor for the passage page's TSS -- the one
+	 * whose IST1 stack all 256 host stub gates use. TR is 0x40 and names
+	 * it.
+	 *
+	 * This CPU's gdt_page is a copy of a template that has NO TSS
+	 * descriptor at all on x86_64 (cpu/common.c: only entries 1-6 are
+	 * initialised), and nothing on this path writes one -- set_tss_desc()
+	 * lives solely inside cpu_init_exception_handling(), which this
+	 * processor deliberately does not call. TR is never reloaded here
+	 * either.
+	 *
+	 * cpu_init() ends in load_fixmap_gdt(cpu), and load_direct_gdt(cpu)
+	 * follows; on a secondary neither is skipped, because the asm/desc.h
+	 * guard is "co_colinux_guest && !co_colinux_own_idt" and the BOOT
+	 * processor already set co_colinux_own_idt. So from cpu_init()
+	 * onwards GDTR names a table whose entry 8 is sixteen zero bytes
+	 * while TR is still 0x40.
+	 *
+	 * The world switch reloads TR from the saved guest state on EVERY
+	 * entry, against whatever GDT it has just lgdt'd, with no present or
+	 * type check (arch/x86_64/switch.c: "andl $0xfffffdff" then "ltr").
+	 * The first host interrupt after this line therefore runs ltr $0x40
+	 * against a null descriptor: #GP, raised with CR3 already the
+	 * guest's, RSP still the host's, and TR still Windows' -- because the
+	 * ltr is what failed. Every passage-page gate is IST1, so delivering
+	 * it reads the TSS through that stale TR, a Windows kernel address
+	 * unmapped here: #PF, whose gate is also IST1, repeats the identical
+	 * read, and so does #DF's. Triple fault: instant reset, no bugcheck,
+	 * no dump, nothing in any log.
+	 *
+	 * So the descriptor travels with the table. Copying the LIVE one,
+	 * rather than calling set_tss_desc(), is the point: this processor
+	 * goes on running on the passage page's TSS, its IST stack and its
+	 * stub IDT, which is the arrangement that makes a fault here arrive
+	 * as a report at all. set_tss_desc() would point TR at this CPU's
+	 * kernel TSS, whose ist[] is still all zero because tss_setup_ist()
+	 * sits in the same function this path does not call.
+	 */
+	{
+		struct desc_ptr live;
+		const struct desc_struct *from;
+		struct desc_struct *to;
+
+		native_store_gdt(&live);
+		from = (const struct desc_struct *)live.address;
+		to   = get_cpu_gdt_rw(cpu);
+
+		to[GDT_ENTRY_TSS]     = from[GDT_ENTRY_TSS];
+		to[GDT_ENTRY_TSS + 1] = from[GDT_ENTRY_TSS + 1];
+	}
+
+	cpu_init();
+
+	/*
+	 * Back onto the WRITABLE GDT alias, and immediately -- nothing may
+	 * cross between cpu_init() and this line.
+	 *
+	 * cpu_init() ends in load_fixmap_gdt(cpu), and on a secondary that
+	 * call is no longer skipped. The guard in asm/desc.h is
+	 * "co_colinux_guest && !co_colinux_own_idt", and co_colinux_own_idt is
+	 * one global that co_colinux_adopt_traps() set during the BOOT
+	 * processor's trap_init(). The boot processor never reached this
+	 * because its own cpu_init() ran while the guard was still closed;
+	 * every processor started afterwards runs it wide open.
+	 *
+	 * GDTR then points at get_cpu_gdt_ro(cpu), the cpu-entry-area alias,
+	 * which is PAGE_KERNEL_RO -- and the world switch writes through it.
+	 * arch/x86_64/switch.c clears the TSS busy bit in the entering side's
+	 * live GDT ("andl $0xfffffdff, 4(%rax)") before every ltr, using the
+	 * base it sgdt'd on the way out. Through a read-only mapping that
+	 * store is a page fault inside the crossing, with real IF clear and
+	 * CR3 already switched: triple fault, no bugcheck, nothing to read.
+	 *
+	 * This is the same line, for the same reason, that
+	 * co_colinux_adopt_traps() runs for the boot processor.
+	 */
+	load_direct_gdt(cpu);
+
+	/*
+	 * Exceptions become the kernel's, before this processor runs any
+	 * code that treats faulting as normal -- and everything after this
+	 * line does: identify_secondary_cpu() and the perf cpuhp callbacks
+	 * use rdmsr_safe and the extable, any WARN is a ud2 that expects
+	 * #UD to step over it, and every text_poke_bp() in the machine
+	 * opens an INT3 window this processor can walk into. On the host's
+	 * stub gates each of those is a vector < 32 crossing that stops
+	 * this vCPU's lane dead (arch/x86_64/switch.c) -- a silent mid-task
+	 * freeze the guest only ever sees as an RCU stall. Measured: CPU 1
+	 * died on the rdmsr in perf_msr_probe, which the extable was
+	 * waiting to fix up.
+	 *
+	 * NMI and interrupts 32-255 keep crossing to the host through THIS
+	 * vCPU's own stubs. See co_colinux_ap_adopt_traps().
+	 */
+	co_colinux_ap_adopt_traps();
+
+	fpu__init_cpu();
+
+	/*
+	 * RCU has to be watching this processor before anything that walks an
+	 * RCU-protected structure, and native does it here for that reason
+	 * (start_secondary, immediately after fpu__init_cpu). Deferring it to
+	 * notify_cpu_starting() below leaves identify_secondary_cpu(),
+	 * set_cpu_sibling_map() and calibrate_delay() running in an extended
+	 * quiescent state: a grace period elsewhere can complete underneath a
+	 * live dereference here. notify_cpu_starting() calls this again and
+	 * that is fine -- native calls it twice for the same reason.
+	 */
+	rcutree_report_cpu_starting(cpu);
+
+	/*
+	 * Before anything slow: this processor has no tick device of its own
+	 * yet, so the watchdog has no idea it is alive. Xen touches it here for
+	 * the same reason.
+	 */
+	touch_softlockup_watchdog();
+
+	identify_secondary_cpu(cpu);
+	set_cpu_sibling_map(cpu);
+	calibrate_delay();
+	cpu_data(cpu).loops_per_jiffy = loops_per_jiffy;
+
+	speculative_store_bypass_ht_init();
+
+	notify_cpu_starting(cpu);
+	set_cpu_online(cpu, true);
+	smp_mb();
+
+	pr_info("colinux: CPU %u is up\n", cpu);
+
+	/*
+	 * Virtual, not real: the host owns the hardware flag and keeps it set
+	 * for as long as this processor is executing.
+	 */
+	local_irq_enable();
+
+	/*
+	 * This processor's own tick device (rung S4). Registered here, on
+	 * this processor, in the slot native uses for setup_percpu_clockev:
+	 * the tick core adopts a device only for the CPU registering it.
+	 * Without it this CPU's timer wheel, hrtimers and RCU callbacks are
+	 * never serviced by anyone, and the first boot-critical msleep()
+	 * scheduled here sleeps forever.
+	 */
+	co_colinux_ap_timer_init();
+
+	cpu_startup_entry(CPUHP_AP_ONLINE_IDLE);
+}
+
+/*
+ * The cooperative stand-in for INIT-SIPI-SIPI.
+ *
+ * The native path reaches do_boot_cpu(), which resets a real physical
+ * processor of the machine this guest is a thread on and points it at a
+ * real-mode trampoline -- it would be trying to boot one of Windows' own CPUs
+ * into Linux. There is no trampoline here and no processor to reset: a vCPU
+ * is a host thread already parked in the driver, waiting to be told where to
+ * begin. So instead of resetting hardware, hand the host a complete initial
+ * state and let it enter the new processor through the world switch, exactly
+ * as it entered the boot processor.
+ *
+ * The state is the same set Xen's cpu_initialize_context() hands its
+ * hypervisor, minus the pieces that describe a machine we do not have:
+ *
+ *   rip	 where to begin -- co_colinux_ap_start below
+ *   rsp	 the idle task's kernel stack, which is what start_secondary
+ *		 would have been given
+ *   cr3	 the kernel's own tables. Not current->mm's: a processor that
+ *		 has not run yet has no user context, and swapper_pg_dir is
+ *		 the root every other one shares its kernel half with.
+ *   gs_base	 the AP's per-CPU offset. The one field that cannot be
+ *		 guessed and cannot be set later: every per-CPU access the new
+ *		 processor makes resolves through it, from its first
+ *		 instruction, including co_colinux_vcpu_id() -- which is how
+ *		 it works out which passage page is its own.
+ *
+ * common_cpu_up() first, and it is not optional: it publishes the idle task
+ * as this CPU's current_task, sets up its IRQ stacks and stack canary, and
+ * calls alternatives_enable_smp(). The new processor reads all of those
+ * before it has run a single instruction of its own.
+ */
+static int co_colinux_kick_ap(unsigned int cpu, struct task_struct *tidle)
+{
+	unsigned long long *params;
+	unsigned char *pp;
+	int rc;
+
+	rc = common_cpu_up(cpu, tidle);
+	if (rc)
+		return rc;
+
+	/*
+	 * Preemption off across filling the parameters and the crossing: they
+	 * live in THIS processor's passage page, and migrating between the two
+	 * would write one processor's request and issue another's.
+	 */
+	preempt_disable();
+	pp = (unsigned char *)co_colinux_passage_page[co_colinux_vcpu_id()];
+	if (!pp) {
+		preempt_enable();
+		return -ENODEV;
+	}
+
+	/*
+	 * Interrupts blocked on arrival, as the state block specifies.
+	 *
+	 * Correct by accident on a first bringup because the array is BSS, and
+	 * wrong on every re-online: the slot still holds EFLAGS.IF from this
+	 * CPU's previous life, so cpu_init(), identify_secondary_cpu() and
+	 * notify_cpu_starting() would run with irqs_disabled() reporting false
+	 * while nothing had enabled anything -- which lockdep and every
+	 * local_irq_save/restore balance check asserts on.
+	 */
+	co_colinux_virtual_if[cpu] = 0;
+
+	params = (unsigned long long *)(pp + CO_PP_PARAMS);
+	params[CO_PP_AP_VCPU]	 = cpu;
+	params[CO_PP_AP_RIP]	 = (unsigned long long)(unsigned long)co_colinux_ap_start;
+	params[CO_PP_AP_RSP]	 = (unsigned long long)(unsigned long)task_pt_regs(tidle);
+	params[CO_PP_AP_CR3]	 = __pa_nodebug(init_mm.pgd);
+	params[CO_PP_AP_GS_BASE] = (unsigned long long)per_cpu_offset(cpu);
+
+	co_colinux_switch_op(CO_OPERATION_START_VCPU);
+	preempt_enable();
+
+	pr_info("colinux: asked the host to start CPU %u\n", cpu);
+	return 0;
+}
+
+/*
+ * The processor list, invented rather than read.
+ *
+ * With the host's MP table left alone (setup.c) nothing enumerates any
+ * processor, so topology_init_possible_cpus() would fabricate a boot APIC and
+ * stop at one. The count belongs to the host anyway -- a vCPU exists where the
+ * host has a thread to run it -- and it arrives as possible_cpus= on the
+ * command line, which topology_apply_cmdline_limits_early() has already turned
+ * into nr_cpu_ids by the time this runs.
+ *
+ * So: register that many, with APIC ids that are simply their CPU numbers.
+ * Nothing reads those ids as hardware -- there is no APIC to address and IPIs
+ * do not go through one -- they exist so the topology bitmaps are populated
+ * and the generic code can be used unmodified. Xen PV fabricates its list the
+ * same way and for the same reason.
+ */
+/* Defined below, installed here -- see the comment on the struct. */
+static struct apic co_colinux_apic;
+
+static void __init co_colinux_smp_config(void)
+{
+	unsigned int i;
+
+	/*
+	 * The inert APIC goes in here, and the placement is measured, not
+	 * chosen.
+	 *
+	 * It has to be installed before anything reads or writes an APIC
+	 * register -- without it, setting smp_found_config below makes
+	 * init_apic_mappings() skip apic_disable(), apic_noop is never
+	 * installed, and the static calls keep pointing at apic_physflat,
+	 * whose accessors touch a fixmap register_lapic_address() never
+	 * mapped. A secondary hit exactly that: #PF in
+	 * default_send_IPI_single_phys.
+	 *
+	 * But installing it from co_colinux_smp_init(), which is where it
+	 * belongs by rights, does not work: that runs near the top of
+	 * setup_arch, before apic_setup_apic_calls() has established the APIC
+	 * static calls, and rewriting call sites that machinery has not
+	 * finished setting up stops the guest a few lines after the early
+	 * console comes up. Measured: kernel #21 hung there.
+	 *
+	 * parse_smp_cfg is late in setup_arch, after the static calls exist,
+	 * still before topology_init_possible_cpus() decides anything, and
+	 * still before any secondary exists to send an IPI.
+	 */
+	apic_install_driver(&co_colinux_apic);
+
+	topology_register_boot_apic(0);
+
+	/*
+	 * From 0, not 1 -- Xen's loop, verbatim, and the one character that
+	 * was rejecting every secondary.
+	 *
+	 * topology_register_boot_apic() calls topo_register_apic() directly
+	 * and so never runs check_for_real_bsp(), leaving real_bsp_apic_id
+	 * unset. Starting at 1 made the FIRST secondary the one to run that
+	 * check: its id is not the boot APIC's, no real BSP can be confirmed,
+	 * and it concludes this is a crash kernel and rejects the processor --
+	 * "Allowing 1 present CPUs" however many were registered.
+	 *
+	 * Registering apic 0 again through the public entry settles it first:
+	 * the ids match, a cooperative guest reports no APICBASE, so the
+	 * enumeration order is trusted and real_bsp_apic_id is set. Every
+	 * secondary after that passes on the early return. Double registration
+	 * of the boot APIC is explicitly supported -- firmware enumeration
+	 * does exactly this on real hardware.
+	 */
+	for (i = 0; i < nr_cpu_ids; i++)
+		topology_register_apic(i, CPU_ACPIID_INVALID, true);
+
+	smp_found_config = 1;
+	pr_info("colinux: %u processor(s), as the host says -- no MP table read\n",
+		nr_cpu_ids);
+}
+
+/*
+ * An inert local APIC, because there is no local APIC.
+ *
+ * This is what the plan specified from the start -- "an inert struct apic
+ * (Xen PV's xen_pv_apic shape), fake topology, and an smp_prepare_cpus
+ * override replace nolapic" -- and skipping it is what produced a long line
+ * of APIC-shaped failures patched one call site at a time.
+ *
+ * The mechanism: setting smp_found_config (co_colinux_smp_config) makes
+ * init_apic_mappings() skip apic_disable(), so apic_noop is never installed
+ * and the static calls keep pointing at apic_physflat. Every apic_read is
+ * then a load from the APIC fixmap, which was never mapped because
+ * register_lapic_address() never ran -- and every send_IPI is a store to it.
+ * A secondary processor reached exactly that and took #PF in
+ * default_send_IPI_single_phys.
+ *
+ * Installing a driver whose accessors touch nothing removes the whole class:
+ * the read patch in parse_topology becomes unnecessary, the fixmap fault
+ * disappears, and send_IPI has somewhere to live -- the shared-memory
+ * doorbell, which is where IPIs belong in a guest whose processors are host
+ * threads.
+ */
+static u32 co_apic_get_id(u32 x)
+{
+	/*
+	 * Ids are CPU numbers here, fabricated by co_colinux_smp_config().
+	 * Nothing addresses them as hardware.
+	 */
+	return x;
+}
+
+static u32 co_apic_read(u32 reg)
+{
+	return 0;
+}
+
+static void co_apic_write(u32 reg, u32 val)
+{
+}
+
+static void co_apic_eoi(void)
+{
+}
+
+static u64 co_apic_icr_read(void)
+{
+	return 0;
+}
+
+static void co_apic_icr_write(u32 low, u32 id)
+{
+}
+
+static int co_apic_probe(void)
+{
+	return co_colinux_guest;
+}
+
+#ifdef CONFIG_SMP
+/*
+ * Every one of these is the shared-memory doorbell: set the vector's bit in
+ * the target's pending set and cross to have the host wake it. There is no
+ * interrupt controller to address, so "send" is a store and a wake.
+ */
+static void co_apic_send_IPI(int cpu, int vector)
+{
+	co_colinux_ipi_send(cpu, vector);
+}
+
+static void co_apic_send_IPI_mask(const struct cpumask *mask, int vector)
+{
+	unsigned int cpu;
+
+	for_each_cpu(cpu, mask)
+		co_colinux_ipi_send(cpu, vector);
+}
+
+static void co_apic_send_IPI_mask_allbutself(const struct cpumask *mask,
+					     int vector)
+{
+	unsigned int cpu, self = smp_processor_id();
+
+	for_each_cpu(cpu, mask)
+		if (cpu != self)
+			co_colinux_ipi_send(cpu, vector);
+}
+
+static void co_apic_send_IPI_allbutself(int vector)
+{
+	co_apic_send_IPI_mask_allbutself(cpu_online_mask, vector);
+}
+
+static void co_apic_send_IPI_all(int vector)
+{
+	co_apic_send_IPI_mask(cpu_online_mask, vector);
+}
+
+static void co_apic_send_IPI_self(int vector)
+{
+	/*
+	 * To itself, and therefore without a crossing: this processor is
+	 * plainly running, so there is nobody to wake. Post it and let the
+	 * next drain pick it up.
+	 */
+	set_bit(vector, co_colinux_ipi_pending[co_colinux_vcpu_id()]);
+}
+#endif
+
+static struct apic co_colinux_apic __ro_after_init = {
+	.name				= "colinux",
+	.probe				= co_apic_probe,
+
+	.disable_esr			= 1,
+
+	.max_apic_id			= UINT_MAX,
+	.get_apic_id			= co_apic_get_id,
+
+	.calc_dest_apicid		= apic_flat_calc_apicid,
+
+#ifdef CONFIG_SMP
+	.send_IPI			= co_apic_send_IPI,
+	.send_IPI_mask			= co_apic_send_IPI_mask,
+	.send_IPI_mask_allbutself	= co_apic_send_IPI_mask_allbutself,
+	.send_IPI_allbutself		= co_apic_send_IPI_allbutself,
+	.send_IPI_all			= co_apic_send_IPI_all,
+	.send_IPI_self			= co_apic_send_IPI_self,
+#endif
+	.read				= co_apic_read,
+	.write				= co_apic_write,
+	.eoi				= co_apic_eoi,
+
+	.icr_read			= co_apic_icr_read,
+	.icr_write			= co_apic_icr_write,
+};
+
+void __init co_colinux_smp_init(void)
+{
+
+	smp_ops.smp_prepare_cpus = co_colinux_smp_prepare_cpus;
+	smp_ops.kick_ap_alive    = co_colinux_kick_ap;
+
+	/*
+	 * native_smp_cpus_done() runs nmi_selftest() and cache_aps_init(),
+	 * which are an NMI IPI and a stop_machine across every processor.
+	 * There is no NMI to send here and no MTRR/PAT state of our own to
+	 * synchronise -- the host owns both -- so the native version can only
+	 * wedge the end of bring-up.
+	 */
+	smp_ops.smp_cpus_done     = co_colinux_smp_cpus_done;
+
+#ifdef CONFIG_SMP
+	smp_ops.smp_send_reschedule       = co_colinux_send_reschedule;
+	smp_ops.send_call_func_ipi        = co_colinux_send_call_func_ipi;
+	smp_ops.send_call_func_single_ipi = co_colinux_send_call_func_single_ipi;
+	smp_ops.stop_other_cpus           = co_colinux_stop_other_cpus;
+	smp_ops.cpu_disable               = co_colinux_cpu_disable;
+	smp_ops.play_dead                 = co_colinux_play_dead;
+	/*
+	 * cpu_die and cleanup_dead_cpu stay NULL: both are optional and both
+	 * describe hardware teardown that does not exist here.
+	 */
+#endif
+
+	/*
+	 * Otherwise the boot processor spins in bare cpu_relax() waiting for a
+	 * secondary to come alive and never hands the processor back to the
+	 * host. A cooperative guest has to yield; Xen sets this hook to a
+	 * hypervisor yield for the same reason.
+	 */
+	smp_ops.poll_sync_state  = co_colinux_yield;
+
+	x86_init.mpparse.parse_smp_cfg = co_colinux_smp_config;
+}
+
 void __init smp_prepare_cpus_common(void)
 {
 	unsigned int cpu, node;
