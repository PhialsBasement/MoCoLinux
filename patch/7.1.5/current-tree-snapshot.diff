diff -urN a/include/linux/irq-entry-common.h b/include/linux/irq-entry-common.h
--- a/include/linux/irq-entry-common.h	2026-07-25 00:21:27.000000000 +1000
+++ b/include/linux/irq-entry-common.h	2026-08-07 15:41:59.526426000 +1000
@@ -194,10 +194,54 @@
 static __always_inline void __exit_to_user_mode_prepare(struct pt_regs *regs,
 							const unsigned long work_mask)
 {
+	extern int co_colinux_guest;
+	extern void co_colinux_drain_time(void);
 	unsigned long ti_work;
 
 	lockdep_assert_irqs_disabled();
 
+	/*
+	 * Deliver the guest's time here as well as at idle, because idle is not
+	 * reached often enough to be the only place.
+	 *
+	 * This guest has no timer hardware and no asynchronous entry: hardware
+	 * interrupts vector through its IDT into the host's stubs and are
+	 * replayed into Windows, so they never enter this kernel. Ticks are
+	 * synthesised instead, and until now the only place that happened was
+	 * co_cpu_idle() -- which runs only when the run queue empties. The
+	 * consequence, written down honestly in the comment at the top of
+	 * co_colinux_drain_time(), is that while the guest is busy, time does
+	 * not pass at all: no tick, therefore no scheduler preemption, therefore
+	 * no way for a task that stays runnable to ever be taken off the
+	 * processor. One such task freezes the whole guest permanently, and
+	 * everything downstream looks broken instead -- the receive kthread's
+	 * schedule_timeout(1) never expires, so the network ring stops draining
+	 * and the bridge idles at zero; nothing reaches the console; and the
+	 * host's monitor loop, never offered an idle yield, spins at full speed.
+	 * No oops, because nothing is faulting: the kernel is simply never
+	 * scheduled.
+	 *
+	 * Every return to userspace passes through here -- syscalls and
+	 * exceptions both, and page faults are exceptions this guest still
+	 * handles itself -- with interrupts disabled and no locks held. That
+	 * makes it the same kind of boundary a hardware timer would have used,
+	 * and it is the point at which Linux already reschedules, so a tick
+	 * delivered before the flags are read is acted on in this very pass.
+	 *
+	 * Cheap when there is nothing to do: drain_time returns after one read
+	 * of the host's clock out of the passage page when less than a tick has
+	 * elapsed.
+	 *
+	 * This does not restore true asynchronous preemption and is not claimed
+	 * to. A task that spins in userspace without ever entering the kernel,
+	 * or a kernel thread that never returns to user mode, still cannot be
+	 * interrupted. Fixing that needs the host to re-enter the guest through
+	 * an injected interrupt frame rather than transparently -- the COPIC the
+	 * port's own notes describe as future work.
+	 */
+	if (co_colinux_guest)
+		co_colinux_drain_time();
+
 	/* Flush pending rcuog wakeup before the last need_resched() check */
 	tick_nohz_user_enter_prepare();
 
@@ -266,6 +310,9 @@
  */
 static __always_inline void exit_to_user_mode(void)
 {
+	extern int co_colinux_guest;
+	extern unsigned long co_colinux_virtual_if[CO_COLINUX_NR_VCPUS];
+
 	instrumentation_begin();
 	unwind_reset_info();
 	trace_hardirqs_on_prepare();
@@ -275,6 +322,27 @@
 	user_enter_irqoff();
 	arch_exit_to_user_mode();
 	lockdep_hardirqs_on(CALLER_ADDR0);
+
+	/*
+	 * "Syscall/interrupt exit enables interrupts" -- by sysret or iretq
+	 * restoring IF, neither of which touches a cooperative guest's
+	 * virtual flag. User mode always runs interruptible, so the virtual
+	 * flag goes on here, the common last step of every return to user.
+	 * Without this, the local_irq_disable() in the exit-work loop was
+	 * the guest's final word, and the first exception taken from
+	 * userspace found interrupts "already off". (asm/irqflags.h)
+	 */
+	if (co_colinux_guest) {
+		/* X86_EFLAGS_IF */
+		co_colinux_virtual_if[co_colinux_vcpu_id()] = 0x200;
+		/*
+		 * And the real flag off for the return sequence, as in
+		 * irqentry_exit(). sysret reloads RFLAGS from r11 and iretq
+		 * from the frame, both of which have IF set, so userspace
+		 * runs interruptible either way.
+		 */
+		asm volatile("cli" : : : "memory");
+	}
 }
 
 /**
@@ -338,6 +406,18 @@
 		bool	exit_rcu;
 		bool	lockdep;
 	};
+	/*
+	 * The interrupted context's virtual interrupt flag, for a cooperative
+	 * guest (see irqentry_enter()). It rides here rather than in
+	 * regs->flags because the real IF bit in every frame must stay set:
+	 * the host is a live Windows kernel, and a frame that iretq's with
+	 * interrupts off puts the machine's only unpinned core to sleep.
+	 * Nesting is free -- this lives on the handler's own stack -- and
+	 * nothing can copy it into a task's saved frame, which is how the
+	 * regs->flags version froze the box: ret_from_fork hands a child the
+	 * parent's pt_regs, IF bit and all.
+	 */
+	unsigned long	co_virtual_if;
 } irqentry_state_t;
 #endif
 
diff -urN a/kernel/entry/common.c b/kernel/entry/common.c
--- a/kernel/entry/common.c	2026-07-25 00:21:27.000000000 +1000
