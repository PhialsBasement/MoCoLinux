+	 * reported when the guest's own stack pointer is the thing that broke.
+	 * GDT_ENTRY_TSS indexes the kernel's table, which is not the one loaded
+	 * here, so this would load whatever happens to sit at that index in the
+	 * host's -- and then a fault has nowhere to land.
+	 */
+	if (co_colinux_guest)
+		return;
+
