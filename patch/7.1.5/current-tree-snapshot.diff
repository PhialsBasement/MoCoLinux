diff --git a/arch/x86/include/asm/irqflags.h b/arch/x86/include/asm/irqflags.h
index 6f25de0..3de85cc 100644
--- a/arch/x86/include/asm/irqflags.h
+++ b/arch/x86/include/asm/irqflags.h
@@ -12,6 +12,37 @@
  * Interrupt control:
  */
 
+extern int co_colinux_guest;
+
+/*
+ * The cooperative guest's interrupt flag is virtual.
+ *
+ * Linux gets a virtual IF: sti/cli/save_fl edit this bit rather than the real
+ * hardware flag. Real IF stays SET the whole time the guest address space is
+ * current -- the host enters the guest with interrupts enabled and nothing in
+ * the guest may clear them.
+ *
+ * That is what keeps the host alive underneath a free-running guest. A real
+ * hardware interrupt vectors through the guest IDT into the passage-page stub,
+ * which performs a full world switch back to the host; the host, restored to
+ * its own context, replays the vector into Windows' live IDT and re-enters the
+ * guest at the interrupted instruction. So the host is never deaf for longer
+ * than one crossing, no matter what the guest is doing -- including the long
+ * stretches of early boot that run under a virtual cli with no cooperative
+ * boundary in sight. The previous policy (real IF clear, yield only at
+ * virtual-sti boundaries) froze the machine exactly there: the pinned core
+ * stopped answering the clock and every other core's TLB-shootdown IPIs
+ * within milliseconds of the guest running free.
+ *
+ * The virtual flag is still what Linux reads back: irqs_disabled() and
+ * saved-flags tests see the guest's own logical state, not the hardware bit
+ * the host owns.
+ *
+ * Holds X86_EFLAGS_IF or 0, so it substitutes directly into saved flags.
+ */
+extern unsigned long co_colinux_virtual_if;
+extern void co_colinux_yield(void);
+
 /* Declaration required for gcc < 4.9 to prevent -Werror=missing-prototypes */
 extern inline unsigned long native_save_fl(void);
 extern __always_inline unsigned long native_save_fl(void)
@@ -29,27 +60,115 @@ extern __always_inline unsigned long native_save_fl(void)
 		     : /* no input */
 		     : "memory");
 
+	if (co_colinux_guest)
+		flags = (flags & ~X86_EFLAGS_IF) | co_colinux_virtual_if;
+
 	return flags;
 }
 
 static __always_inline void native_irq_disable(void)
 {
+	if (co_colinux_guest) {
+		co_colinux_virtual_if = 0;
+		asm volatile("": : :"memory");
+		return;
+	}
+
 	asm volatile("cli": : :"memory");
 }
 
 static __always_inline void native_irq_enable(void)
 {
+	if (co_colinux_guest) {
+		/*
+		 * The virtual bit, AND the real one.
+		 *
+		 * For most of this port the real flag needed no help here: the
+		 * host entered the guest with interrupts on and nothing in the
+		 * guest could clear them, because every cli was virtual and
+		 * every gate in the guest's IDT went straight to a host stub
+		 * that crossed back within microseconds.
+		 *
+		 * Owning the IDT ended that. Two things now clear the real
+		 * flag behind Linux's back, both in hardware, neither of them
+		 * anything the guest chose:
+		 *
+		 *   - an interrupt gate clears IF on delivery, and vectors
+		 *     0-31 are the kernel's own handlers now, so the flag
+		 *     stays clear for as long as the handler runs -- and a
+		 *     user page fault runs until the block layer has been to
+		 *     the disk and back.
+		 *   - SYSCALL clears IF from MSR_SYSCALL_MASK, so it stays
+		 *     clear for the whole system call.
+		 *
+		 * In both, Linux believes it re-enabled interrupts: syscall
+		 * entry calls local_irq_enable(), fault handlers call
+		 * cond_local_irq_enable(). Setting only the virtual bit there
+		 * left the processor deaf for the entire syscall or fault,
+		 * which is the host freeze -- the same failure as the old
+		 * yield-only policy, arriving by a new route.
+		 *
+		 * So sti here, where Linux says interrupts are on. It makes
+		 * the invariant repair itself: whatever cleared the real flag,
+		 * the next enable puts it back, and the windows that remain
+		 * are the short prologues Linux already keeps short. The
+		 * virtual bit continues to be what the guest reads back.
+		 */
+		co_colinux_virtual_if = X86_EFLAGS_IF;
+		asm volatile("sti" : : : "memory");
+		return;
+	}
+
 	asm volatile("sti": : :"memory");
 }
 
 static __always_inline void native_safe_halt(void)
 {
+	/*
+	 * The idle halt, and the one the original no-halt patch missed.
+	 *
+	 * native_halt() below is the emergency halt every panic path ends in.
+	 * This is the other one: default_idle() reaches it through
+	 * raw_safe_halt(), so it is where a booted, idle guest waits. A guest
+	 * that reaches idle and really executes `sti; hlt` takes its core away
+	 * exactly as a panicking one would -- the boot succeeding is not a
+	 * reason to let it hang the host.
+	 *
+	 * Two ud2 rather than one. A single ud2 is how WARN and BUG trap, and
+	 * the host steps over a warning; the host must not step over a halt. No
+	 * WARN is ever followed by a second ud2, so `ud2; ud2` is a signature
+	 * the host can tell apart from a warning with certainty, and it stops
+	 * on it and reports the guest reached idle.
+	 */
+	if (co_colinux_guest)
+		asm volatile("ud2; ud2");
+
 	x86_idle_clear_cpu_buffers();
 	asm volatile("sti; hlt": : :"memory");
 }
 
+/*
+ * Cooperative Linux must never actually halt.
+ *
+ * The guest is code running inside a host process, on a CPU the host owns. HLT
+ * with interrupts disabled waits for an NMI or a reset, so a guest that reaches
+ * it takes that core away permanently -- the host cannot preempt it, the other
+ * cores notice, and the machine bugchecks. Every panic path ends in exactly
+ * this, so the failure that most wants reporting is the one that would take the
+ * host down instead.
+ *
+ * ud2 raises #UD, which reaches the host's stub through the guest IDT and
+ * returns control with the fault recorded. The i386 port does the same thing by
+ * calling co_terminate from head_32.S's hlt_loop; this is the same idea at the
+ * single place every halt goes through.
+ */
 static __always_inline void native_halt(void)
 {
+	/* ud2; ud2 -- the cooperative-halt signature, told apart from the
+	 * single ud2 of a WARN. See native_safe_halt above. */
+	if (co_colinux_guest)
+		asm volatile("ud2; ud2");
+
 	x86_idle_clear_cpu_buffers();
 	asm volatile("hlt": : :"memory");
 }
diff --git a/arch/x86/include/asm/special_insns.h b/arch/x86/include/asm/special_insns.h
index 46aa2c9..a66560d 100644
--- a/arch/x86/include/asm/special_insns.h
+++ b/arch/x86/include/asm/special_insns.h
@@ -38,6 +38,39 @@ static __always_inline unsigned long __native_read_cr3(void)
 	return val;
 }
 
+/*
+ * A cooperative guest owns CR3 again, and has to.
+ *
+ * This was a no-op for the whole of bring-up, and that was right then: the
+ * host built the address space the guest ran in, and a CR3 write replaced it
+ * with a table describing a machine that was never there -- the next
+ * instruction fetched from an address space not containing it, the fault
+ * delivered through an unmapped IDT, the double-fault handler unmapped as
+ * well. Triple fault and an immediate reset, on a host that is not a virtual
+ * machine but the actual computer.
+ *
+ * What changed is that the guest no longer runs in the host's arrangement. It
+ * was switched into the kernel's own init_top_pgt, with the host's three
+ * mappings -- the direct map, the boot stack, and the passage page carrying
+ * the switch code and its stack -- grafted into the top level. So the tables
+ * are the kernel's to manage, and every process address space it builds
+ * inherits those three by construction: init_top_pgt *is* swapper_pg_dir, and
+ * pgd_alloc() clones KERNEL_PGD_BOUNDARY..511 out of it, which is indices
+ * 273..511, and the three grafts sit at 273, 289 and 501.
+ *
+ * Refusing the write is what stopped userspace existing. execve builds a new
+ * mm and switch_mm() activates it with exactly this instruction; skipped, the
+ * process runs with the previous address space, its own pages are not mapped,
+ * and the first access to them faults. That is init dying with EFAULT before
+ * its first instruction, which is where this port sat until the guard came
+ * off.
+ *
+ * The passage page must be present in every table loaded here, or the crossing
+ * that follows has nowhere to execute. Nothing checks it at each write --
+ * there is no cheap way to, and the guest is trusted, as it is upstream.
+ */
+extern int co_colinux_guest;
+
 static __always_inline void native_write_cr3(unsigned long val)
 {
 	asm volatile("mov %0,%%cr3": : "r" (val) : "memory");
