 #include <linux/percpu.h>
@@ -476,6 +477,36 @@ void __no_profile native_write_cr4(unsigned long val)
 {
 	unsigned long bits_changed = 0;
 
+	/*
+	 * Refuse a value that would clear CR4.PAE while long mode is active.
+	 *
+	 * That is an immediate #GP, and the kernel gets there honestly. The
+	 * flush paths write back this_cpu_read(cpu_tlbstate.cr4), a shadow
+	 * primed by cr4_init_shadow() from x86_64_start_kernel(). A cooperative
+	 * guest is entered at start_kernel and never runs that function, so the
+	 * shadow is zero and the first __native_tlb_flush_global() writes zero
+	 * to CR4:
+	 *
+	 *     vector 13 at native_write_cr4, error code 0
+	 *
+	 * with the guest a few instructions into setup_arch and nothing wrong
+	 * with the value it believes it is preserving.
+	 *
+	 * The shadow does not read back as zero, it reads back as all ones --
+	 * 0xffffffffffffff7f reached this function, which is ~0 with PGE masked
+	 * out by __native_tlb_flush_global. So the test is not "is PAE set" but
+	 * "is this a CR4 at all": the register has no defined bits above 31, so
+	 * anything in the top half is not a value the kernel computed.
+	 *
