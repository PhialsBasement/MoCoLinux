diff --git a/arch/x86/kernel/early_printk.c b/arch/x86/kernel/early_printk.c
index cba7530..704430e 100644
--- a/arch/x86/kernel/early_printk.c
+++ b/arch/x86/kernel/early_printk.c
@@ -370,6 +370,139 @@ static struct console early_serial_console = {
 	.index =	-1,
 };
 
+/*
+ * Cooperative Linux: an early console that writes into the passage page.
+ *
+ * There is no device here to talk to. The guest runs inside a host process's
+ * address space and its only channel out is memory both sides can see, so the
+ * console appends bytes to a ring in the passage page and the host drains it
+ * after the next world switch.
+ *
+ * co_colinux_console_ring is filled in by the host before the guest executes
+ * anything. That matters: it means output works from the very first
+ * instruction, rather than from whenever setup_early_printk() happens to run
+ * during setup_arch(). A real machine has to bootstrap its own console and is
+ * blind until it does; the host can simply write the pointer in beforehand,
+ * and being blind through early boot is exactly how a port like this gets
+ * stuck.
+ *
+ * written counts everything the guest tried to emit, including what did not
+ * fit. The host compares it against capacity to report truncation rather than
+ * silently showing a short log.
+ */
+struct co_console_ring {
+	volatile unsigned long long written;
+	volatile unsigned long long capacity;
+	volatile char text[];
+};
+
+struct co_console_ring *co_colinux_console_ring;
+EXPORT_SYMBOL(co_colinux_console_ring);
+
+/*
+ * Set by the host before the guest runs. Distinct from the console ring so that
+ * "is this a cooperative guest" is not inferred from "does it have somewhere to
+ * print", which are different questions that happen to coincide today.
+ */
+int co_colinux_guest;
+EXPORT_SYMBOL(co_colinux_guest);
+
+/*
+ * The guest's virtual interrupt flag -- see asm/irqflags.h. Real IF stays
+ * clear while the guest is current; sti/cli/save_fl edit this instead. Holds
+ * X86_EFLAGS_IF or 0 so it substitutes directly into saved flags.
+ */
+unsigned long co_colinux_virtual_if;
+EXPORT_SYMBOL(co_colinux_virtual_if);
+/*
+ * arch/x86/boot/startup is compiled with every symbol prefixed __pi_, so it can
+ * only reach what has been deliberately aliased. It gets here through the
+ * guards in asm/desc.h, which it includes for native_load_gdt/native_load_idt.
+ */
+SYM_PIC_ALIAS(co_colinux_guest);
+
+static void early_colinux_write(struct console *con, const char *s, unsigned n)
+{
+	struct co_console_ring *ring = co_colinux_console_ring;
+
+	if (!ring)
+		return;
+
+	while (n-- > 0) {
+		if (ring->written < ring->capacity)
+			ring->text[ring->written] = *s;
+		ring->written++;
+		s++;
+	}
+
+	/*
+	 * Early boot can run for a long time without toggling logical IRQs. Each
+	 * completed console record is nevertheless a safe cooperative boundary,
+	 * and keeps Windows responsive while initcalls run at native speed.
+	 */
+	co_colinux_yield();
+}
+
+static struct console early_colinux_console = {
+	.name =		"earlycolinux",
+	.write =	early_colinux_write,
+	.flags =	CON_PRINTBUFFER,
+	.index =	-1,
+};
+
+/*
+ * Register the cooperative console as early as setup_arch can manage.
+ *
+ * Waiting for parse_early_param() to act on earlyprintk= is too late. In
+ * setup_arch the order is idt_setup_early_traps() at the top, then
+ * e820__memory_setup(), then parse_early_param() -- so the stretch where a
+ * cooperative guest is most likely to die first is also the stretch with no
+ * console registered and, because the kernel has just replaced the host's
+ * interrupt stubs, nothing able to report a fault either.
+ *
+ * Self-gating: it does nothing unless the host has filled in the ring pointer,
+ * so a kernel booted normally on real hardware is unaffected.
+ */
+static void early_console_register(struct console *con, int keep_early);
+
+void co_colinux_console_init(void)
+{
+	if (!co_colinux_console_ring)
+		return;
+
+	/*
+	 * Not "if (early_console) return", which is the obvious guard and is
+	 * wrong here for the one reason that is easy to miss: the host sets
+	 * early_console itself, before the guest executes anything, so that
+	 * early_printk() works from the first instruction rather than from
+	 * wherever setup_early_printk() happens to run.
+	 *
+	 * That pointer being set is therefore not evidence that a console was
+	 * registered -- it is evidence of the opposite. Both registration paths
+	 * test it and both bailed on it: this one, and setup_early_printk(),
+	 * which opens with the same check. So nothing ever called
+	 * register_console(), and printk() only writes to registered consoles.
+	 * The kernel produced eighty-six records and the ring received none of
+	 * them, which read as a broken console and was a console that was never
+	 * connected.
+	 *
+	 * So: proceed if the pointer is unset or is already ours, and stand
+	 * aside only for a console someone else chose.
+	 */
+	if (early_console && early_console != &early_colinux_console)
+		return;
+
+	/*
+	 * CON_PRINTBUFFER means registration replays the ringbuffer from the
+	 * beginning, so everything printed before this point arrives too. The
+	 * ring is one page and the boot says far more than that, so it holds
+	 * the earliest output and reports the rest as truncated -- which is the
+	 * right half to keep, since the earliest output is where a boot that
+	 * goes wrong starts going wrong.
+	 */
+	early_console_register(&early_colinux_console, 1);
+}
+
 static void early_console_register(struct console *con, int keep_early)
 {
 	if (con->index != -1) {
@@ -398,6 +531,10 @@ static int __init setup_early_printk(char *buf)
 	keep = (strstr(buf, "keep") != NULL);
 
 	while (*buf != '\0') {
