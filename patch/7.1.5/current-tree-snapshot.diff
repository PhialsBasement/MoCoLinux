 	asm volatile("mov %0,%%cr4": "+r" (val) : : "memory");
 
diff --git a/arch/x86/kernel/early_printk.c b/arch/x86/kernel/early_printk.c
index cba7530..21fde01 100644
--- a/arch/x86/kernel/early_printk.c
+++ b/arch/x86/kernel/early_printk.c
@@ -370,6 +370,187 @@ static struct console early_serial_console = {
 	.index =	-1,
 };
 
+/*
+ * Cooperative Linux: an early console that writes into the passage page.
+ *
+ * There is no device here to talk to. The guest runs inside a host process's
+ * address space and its only channel out is memory both sides can see, so the
+ * console appends bytes to a ring in the passage page and the host drains it
+ * after the next world switch.
+ *
+ * co_colinux_console_ring is filled in by the host before the guest executes
+ * anything. That matters: it means output works from the very first
+ * instruction, rather than from whenever setup_early_printk() happens to run
+ * during setup_arch(). A real machine has to bootstrap its own console and is
+ * blind until it does; the host can simply write the pointer in beforehand,
+ * and being blind through early boot is exactly how a port like this gets
+ * stuck.
+ *
+ * written counts everything the guest tried to emit, including what did not
+ * fit. The host compares it against capacity to report truncation rather than
+ * silently showing a short log.
+ */
+struct co_console_ring {
+	volatile unsigned long long written;
+	volatile unsigned long long capacity;
+	volatile char text[];
+};
+
+struct co_console_ring *co_colinux_console_ring;
+EXPORT_SYMBOL(co_colinux_console_ring);
+
+/*
+ * The interactive console's two rings, and why they live here rather than in
+ * the passage page.
+ *
+ * The early ring above is one-way and write-only: the guest appends, the host
+ * reads it when the run ends. A terminal needs the other direction and needs
+ * both to work while the guest is still running, which means a circular
+ * buffer in each direction rather than an append-until-full log.
+ *
+ * The passage page has no room -- host_temp is exactly seven pages and every
+ * one is spoken for (IDT, stubs, IST stack, a deliberate gap, TSS, early
+ * console, FPU) -- so this is an ordinary kernel object at an ordinary kernel
+ * address, and the host reaches it the way it reaches any other guest memory,
+ * by walking the guest's page tables. co_kload_read/co_kload_write already do
+ * exactly that, and the daemon already knows how to resolve a symbol.
+ *
+ * Each ring is a free-running head and tail with power-of-two sizes, so an
+ * index is masked rather than compared and neither side has to write the
+ * other's counter: for input the host owns in_head and the guest owns in_tail,
+ * for output the guest owns out_head and the host owns out_tail. One writer
+ * per word is what makes this safe without a lock across two worlds.
+ */
+#define CO_CONSOLE_IN_SIZE	1024
