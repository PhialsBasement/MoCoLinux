+		 * calling this, so no replayed host interrupt can clobber the
+		 * faulting address. And safe for stacks: the asm entry path
+		 * has already switched to the kernel stack and swapped GS by
+		 * the time any of this C code runs.
+		 */
+		asm volatile("sti" : : : "memory");
+	}
