+#define CO_PP_LINUXVM_STATE	0x880
+#define CO_PP_OPERATION		0x9c0
+#define CO_PP_PARAMS		0x9c8	/* params[0] */
+
+#define CO_PP_PARAM(n)		(CO_PP_PARAMS + (n) * 8)
+
+#define CO_OPERATION_BLOCK_PROBE	17
+#define CO_OPERATION_BLOCK_IO		18
