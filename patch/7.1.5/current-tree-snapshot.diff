+	 * IF bit stays exactly as the guest was entered with -- set -- so
+	 * whatever the guest's virtual state, the processor keeps taking the
+	 * host's interrupts.
+	 */
+	if (co_colinux_guest) {
+		co_colinux_virtual_if[co_colinux_vcpu_id()] =
+			user_mode(regs) ? 0x200 : state.co_virtual_if;
+		/*
+		 * Real interrupts off for the epilogue only.
+		 *
+		 * The asm that follows -- restore the registers, swapgs,
+		 * iretq -- is written to be uninterruptible, and
+		 * CONFIG_DEBUG_ENTRY asserts exactly that with a ud2 on the
+		 * real flag. The iretq then loads regs->flags, whose IF bit
+		 * is set because the guest always runs with it set, so the
+		 * guest resumes interruptible. The deaf window is the twenty
+		 * instructions to the iretq, not the handler.
+		 */
+		asm volatile("cli" : : : "memory");
+	}
 }
 
 irqentry_state_t noinstr irqentry_nmi_enter(struct pt_regs *regs)
diff -urN '--exclude=.*' '--exclude=*.o' '--exclude=*.cmd' '--exclude=*.ko' a/kernel/smp.c b/kernel/smp.c
--- a/kernel/smp.c	2026-07-25 00:21:27.000000000 +1000
+++ b/kernel/smp.c	2026-08-08 01:18:46.042476900 +1000
@@ -348,6 +348,29 @@
 
 static __always_inline void csd_lock_wait(call_single_data_t *csd)
 {
+	/*
+	 * Cooperative guest: this wait is bounded on real hardware because
+	 * the spinner has IF=1 and the incoming CALL_FUNCTION IPI preempts
+	 * the spin. Here, posted vectors are serviced only at cooperative
+	 * boundaries -- the idle crossing and the exit-to-user drain --
+	 * and this spin reaches neither. Two processors cross-calling each
+	 * other (a text_poke_sync against a TLB shootdown is enough) would
+	 * starve forever: no fault, no tick, no watchdog, nothing. So poll
+	 * this CPU's own pending set while spinning -- the exact work a
+	 * hardware IPI would have preempted us for, including the unlock of
+	 * the csd the other processor is spinning on.
+	 */
+	extern int co_colinux_guest;
+
+	if (co_colinux_guest) {
+		while (READ_ONCE(csd->node.u_flags) & CSD_FLAG_LOCK) {
+			co_colinux_ipi_poll();
+			cpu_relax();
+		}
+		smp_acquire__after_ctrl_dep();
+		return;
+	}
+
 	smp_cond_load_acquire(&csd->node.u_flags, !(VAL & CSD_FLAG_LOCK));
 }
 #endif
