index 00aeae8..be67d20 100644
--- a/arch/x86/include/asm/desc.h
+++ b/arch/x86/include/asm/desc.h
@@ -205,13 +205,49 @@ static inline void native_set_ldt(const void *addr, unsigned int entries)
 	}
 }
 
+/*
+ * While a cooperative guest is being brought up, the host owns the descriptor
+ * tables and the guest may not replace them.
+ *
+ * Guarding the individual callers was tried first and is not good enough:
+ * idt.c has four of them, head_64.S and head64.c have one each, and cpu_init()
+ * and the trap setup add more. Missing one is not a bug that reports itself.
+ * The host single-steps the guest with the trap flag, and the debug trap is
+ * delivered through the host's IDT -- so the instant the guest loads its own,
+ * the only bound on a guest running with interrupts disabled is gone. It does
+ * not fault, it does not stop: it runs away inside the host's ioctl and the
+ * machine has to be power-cycled. Twice, so far.
+ *
+ * Guarding lgdt/lidt/ltr themselves closes every path at once, including ones
+ * that do not exist yet. The tables the host installed stay loaded, they are
+ * mapped in the guest's address space, and the world switch carries GDTR and
+ * IDTR across every crossing in both directions.
+ *
+ * "Eventually" is co_colinux_adopt_traps(), at the end of trap_init(): by then
+ * idt_table holds real handlers, the TSS descriptor is written and the IST
+ * stacks exist, so the kernel can survive taking a fault. It sets
+ * co_colinux_own_idt and performs the one lgdt/ltr/lidt sequence itself; the
+ * guards stay closed for everything before that point and open for everything
+ * after, so cpu_init()'s loads during early boot are still skipped but the
+ * kernel owns its tables for the rest of its life.
+ */
+extern int co_colinux_guest;
+extern int co_colinux_own_idt;
+void co_colinux_adopt_traps(void);
+
 static inline void native_load_gdt(const struct desc_ptr *dtr)
 {
+	if (co_colinux_guest && !co_colinux_own_idt)
+		return;
+
 	asm volatile("lgdt %0"::"m" (*dtr));
 }
 
 static __always_inline void native_load_idt(const struct desc_ptr *dtr)
 {
+	if (co_colinux_guest && !co_colinux_own_idt)
+		return;
+
 	asm volatile("lidt %0"::"m" (*dtr));
 }
 
@@ -258,6 +294,16 @@ static inline void native_load_tr_desc(void)
 	bool restore = 0;
 	struct desc_struct *fixmap_gdt;
 
+	/*
+	 * The task register goes with the GDT that is actually loaded. Until
+	 * co_colinux_adopt_traps() has switched to the kernel's own GDT,
+	 * GDT_ENTRY_TSS indexes a table that is not the one in GDTR, so this
+	 * would load whatever happens to sit at that index in the host's --
+	 * and then a fault has nowhere to land.
+	 */
+	if (co_colinux_guest && !co_colinux_own_idt)
+		return;
+
 	native_store_gdt(&gdt);
 	fixmap_gdt = get_cpu_gdt_ro(cpu);
 
