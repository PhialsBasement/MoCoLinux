diff -urN '--exclude=.*' '--exclude=*.o' '--exclude=*.cmd' '--exclude=*.ko' a/drivers/net/conet_colinux.c b/drivers/net/conet_colinux.c
--- a/drivers/net/conet_colinux.c	1970-01-01 10:00:00.000000000 +1000
+++ b/drivers/net/conet_colinux.c	2026-08-02 17:08:57.432206200 +1000
@@ -0,0 +1,289 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * A cooperative ethernet device for a coLinux guest.
+ *
+ * The transport is the console's, one size up: two rings in an ordinary
+ * kernel object, one writer per word per direction, reached from the host by
+ * walking the guest's page tables. Nothing here is mapped anywhere special
+ * and nothing is shared with the crossing -- the host's half (a pump ioctl
+ * serviced by a second daemon process) copies frames in and out while the
+ * guest runs, exactly as the terminal does with keystrokes.
+ *
+ * Frames travel whole: a 32-bit length, the frame, padding up to a four-byte
+ * boundary. Every record starts four-byte aligned and the rings are a
+ * multiple of four, so the length word never straddles the wrap and both
+ * sides read it in one piece. The indices free-run and are masked, as the
+ * console's are, so full is head - tail == size with no spare-slot ambiguity.
+ *
+ * A full TX ring drops the frame rather than stopping the queue. This is
+ * ethernet: a dropped frame is a thing the protocols above already survive,
+ * and the ring is only ever full when nothing is draining it -- at which
+ * point a stopped queue would wedge every writer against a host that may
+ * never come. The console made the same choice for the same reason.
+ *
+ * There is no interrupt to receive with, so RX is a kthread polling the ring
+ * a few times per millisecond of guest time, like hvc's. The latency floor is
+ * really the host's idle re-entry cadence, not the poll period.
+ *
+ * The host finds the rings by resolving co_colinux_net_io from the image, as
+ * it resolves the console object. The layout is therefore ABI:
+ *
+ *   0x00 tx_head   guest writes    0x08 rx_head   host writes
+ *   0x04 tx_tail   host writes     0x0c rx_tail   guest writes
+ *   0x10           tx ring         0x10 + TX_SIZE rx ring
+ *
+ * (tx and rx are named from where this file stands: tx is guest to host.)
+ */
+
+#include <linux/console.h>	/* co_colinux_guest, co_colinux_yield */
+#include <linux/etherdevice.h>
+#include <linux/init.h>
+#include <linux/kthread.h>
+#include <linux/netdevice.h>
+#include <linux/sched.h>
+#include <linux/skbuff.h>
+#include <linux/types.h>
+
+#define CO_NET_TX_SIZE		(128 * 1024)
+#define CO_NET_RX_SIZE		(128 * 1024)
+#define CO_NET_MAX_FRAME	1514
+
+struct co_net_io {
+	volatile u32 tx_head;		/* guest writes */
+	volatile u32 tx_tail;		/* host writes  */
+	volatile u32 rx_head;		/* host writes  */
+	volatile u32 rx_tail;		/* guest writes */
+	u8 tx[CO_NET_TX_SIZE];
+	u8 rx[CO_NET_RX_SIZE];
+};
+
+struct co_net_io co_colinux_net_io;
+EXPORT_SYMBOL(co_colinux_net_io);
+
+static struct net_device *co_net_dev;
+static struct task_struct *co_net_rx_thread;
+
+/*
+ * Locally administered, unicast, and constant. There is exactly one of these
+ * devices in exactly one guest, and a fixed address means a failure on the
+ * wire reads as itself across runs instead of changing name every boot.
+ */
+static const u8 co_net_mac[ETH_ALEN] = { 0x02, 0xc0, 0x11, 0x00, 0x00, 0x01 };
+
+/* One record's footprint in a ring: the length word, the frame, the pad. */
+static inline u32 co_net_record_bytes(u32 len)
+{
+	return 4 + ALIGN(len, 4);
+}
+
+static netdev_tx_t co_net_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	struct co_net_io *io = &co_colinux_net_io;
+	u32 head = io->tx_head;
+	u32 tail = io->tx_tail;
+	u32 len = skb->len;
+	u32 off, first;
+
+	if (len > CO_NET_MAX_FRAME) {
+		dev->stats.tx_dropped++;
+		goto out;
+	}
+
+	if ((head - tail) + co_net_record_bytes(len) > CO_NET_TX_SIZE) {
+		dev->stats.tx_dropped++;
+		goto out;
+	}
+
+	off = head & (CO_NET_TX_SIZE - 1);
+	*(u32 *)&io->tx[off] = len;
+	off = (off + 4) & (CO_NET_TX_SIZE - 1);
+
+	first = min_t(u32, len, CO_NET_TX_SIZE - off);
+	skb_copy_bits(skb, 0, &io->tx[off], first);
+	if (first < len)
+		skb_copy_bits(skb, first, &io->tx[0], len - first);
+
+	/*
+	 * The frame must be visible before the head that announces it; the
+	 * host may look from another processor at any moment.
+	 */
+	smp_wmb();
+	io->tx_head = head + co_net_record_bytes(len);
+
+	dev->stats.tx_packets++;
+	dev->stats.tx_bytes += len;
+
+out:
+	dev_kfree_skb(skb);
+
+	/*
+	 * Hand the host the CPU so the frame leaves promptly. A guest that
+	 * has just sent a request is usually about to go idle waiting for
+	 * the answer; this is the same trade put_chars makes after a prompt.
+	 */
+	co_colinux_yield();
+
+	return NETDEV_TX_OK;
+}
+
+/*
+ * Drain whatever the host has queued. Returns the number of frames taken,
+ * so the poll loop can spin while there is work and sleep when there is not.
+ */
+static int co_net_rx_drain(struct net_device *dev)
+{
+	struct co_net_io *io = &co_colinux_net_io;
+	u32 head = io->rx_head;
+	u32 tail = io->rx_tail;
+	int taken = 0;
+
+	while (tail != head) {
+		struct sk_buff *skb;
+		u32 off, first, len;
+
+		/* the record was written before rx_head advanced */
+		smp_rmb();
+
+		off = tail & (CO_NET_RX_SIZE - 1);
+		len = *(u32 *)&io->rx[off];
+
+		/*
+		 * A length that cannot be a frame, or that reaches past what
+		 * the host has published, means the rings have desynchronised.
+		 * There is no way to find the next record boundary from inside
+		 * the corruption, so drop the lot and start empty -- and say
+		 * so, because a resync is a bug's footprint, not weather.
+		 */
+		if (len == 0 || len > CO_NET_MAX_FRAME ||
+		    co_net_record_bytes(len) > head - tail) {
+			net_err_ratelimited(
+				"conet: rx ring desync (len %u, used %u), resetting\n",
+				len, head - tail);
+			dev->stats.rx_errors++;
+			tail = head;
+			break;
+		}
+
+		off = (off + 4) & (CO_NET_RX_SIZE - 1);
+
+		skb = netdev_alloc_skb(dev, len + NET_IP_ALIGN);
+		if (!skb) {
+			dev->stats.rx_dropped++;
+		} else {
+			skb_reserve(skb, NET_IP_ALIGN);
+			first = min_t(u32, len, CO_NET_RX_SIZE - off);
+			skb_put_data(skb, &io->rx[off], first);
+			if (first < len)
+				skb_put_data(skb, &io->rx[0], len - first);
+
+			skb->protocol = eth_type_trans(skb, dev);
+			dev->stats.rx_packets++;
+			dev->stats.rx_bytes += len;
+			netif_rx(skb);
+		}
+
+		tail += co_net_record_bytes(len);
+		taken++;
+	}
+
+	/*
+	 * Consumed. On x86 this store cannot become visible before the loads
+	 * above complete, which is what keeps the host from overwriting bytes
+	 * still being read; the console's get_chars leans on the same
+	 * ordering.
+	 */
+	io->rx_tail = tail;
+
+	return taken;
+}
+
+static int co_net_rx_poll(void *arg)
+{
+	struct net_device *dev = arg;
+
+	while (!kthread_should_stop()) {
+		if (co_net_rx_drain(dev) == 0) {
+			set_current_state(TASK_INTERRUPTIBLE);
+			if (!kthread_should_stop())
+				/*
+			 * One jiffy, not two.
+			 *
+			 * This sleep is one of three polling intervals in
+			 * series on every round trip the guest makes -- this
+			 * one, the host monitor loop's idle sleep, and the
+			 * slirp bridge's select timeout -- and their sum is the
+			 * latency floor. A ping to slirp's own gateway,
+			 * answered by a process on the same machine with no
+			 * network involved, measured 4 ms against a predicted
+			 * 2 + 1 + 2. Throughput is window over round trip, so
+			 * this interval is worth as much as any buffer size.
+			 */
+			schedule_timeout(1);
+			__set_current_state(TASK_RUNNING);
+		}
+	}
+
+	return 0;
+}
+
+static int co_net_open(struct net_device *dev)
+{
+	struct task_struct *t;
+
+	t = kthread_run(co_net_rx_poll, dev, "conet-rx");
+	if (IS_ERR(t))
+		return PTR_ERR(t);
+
+	co_net_rx_thread = t;
+	netif_start_queue(dev);
+	return 0;
+}
+
+static int co_net_stop(struct net_device *dev)
+{
+	netif_stop_queue(dev);
+
+	if (co_net_rx_thread) {
+		kthread_stop(co_net_rx_thread);
+		co_net_rx_thread = NULL;
+	}
+
+	return 0;
+}
+
+static const struct net_device_ops co_net_ops = {
+	.ndo_open		= co_net_open,
+	.ndo_stop		= co_net_stop,
+	.ndo_start_xmit		= co_net_xmit,
+	.ndo_validate_addr	= eth_validate_addr,
+};
+
+static int __init co_net_init(void)
+{
+	struct net_device *dev;
+	int rc;
+
+	if (!co_colinux_guest)
+		return 0;
+
+	dev = alloc_etherdev(0);
+	if (!dev)
+		return -ENOMEM;
+
+	dev->netdev_ops = &co_net_ops;
+	eth_hw_addr_set(dev, co_net_mac);
+
+	rc = register_netdev(dev);
+	if (rc) {
+		free_netdev(dev);
+		return rc;
+	}
+
+	co_net_dev = dev;
+	netdev_info(dev, "conet: cooperative ethernet, %pM, rings at %px (%u+%u)\n",
+		    dev->dev_addr, &co_colinux_net_io,
+		    CO_NET_TX_SIZE, CO_NET_RX_SIZE);
+
+	return 0;
+}
+device_initcall(co_net_init);
