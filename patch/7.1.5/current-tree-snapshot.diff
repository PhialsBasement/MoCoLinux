+{
+	unsigned char *pp = (unsigned char *)co_colinux_passage_page[co_colinux_vcpu_id()];
+	struct clock_event_device *evt = &co_colinux_clockevent[co_colinux_vcpu_id()];
+	const u64 per_tick = 10000000 / HZ;	/* 100 ns units */
+	static u64 last_mono[CO_COLINUX_NR_VCPUS];
+	u64 *lm = &last_mono[co_colinux_vcpu_id()];
+	u64 now;
+	unsigned int n;
