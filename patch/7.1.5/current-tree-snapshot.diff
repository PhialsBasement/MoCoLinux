+	 *
+	 * regs->flags is not touched here or anywhere on this path. The real
+	 * IF bit stays exactly as the guest was entered with -- set -- so
+	 * whatever the guest's virtual state, the processor keeps taking the
+	 * host's interrupts.
+	 */
+	if (co_colinux_guest) {
+		co_colinux_virtual_if = user_mode(regs) ? 0x200
+						       : state.co_virtual_if;
+		/*
+		 * Real interrupts off for the epilogue only.
