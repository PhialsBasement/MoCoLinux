diff -urN '--exclude=.*' '--exclude=*.o' '--exclude=*.cmd' '--exclude=*.ko' a/arch/x86/include/asm/irqflags.h b/arch/x86/include/asm/irqflags.h
--- a/arch/x86/include/asm/irqflags.h	2026-07-25 00:21:27.000000000 +1000
+++ b/arch/x86/include/asm/irqflags.h	2026-08-08 01:18:31.424756300 +1000
@@ -7,11 +7,127 @@
 #ifndef __ASSEMBLER__
 
 #include <asm/nospec-branch.h>
+/* co_colinux_vcpu_id() below reads a per-CPU variable under CONFIG_SMP. */
+#include <asm/percpu.h>
 
 /*
  * Interrupt control:
  */
 
+extern int co_colinux_guest;
+
+/*
+ * The cooperative guest's interrupt flag is virtual.
+ *
+ * Linux gets a virtual IF: sti/cli/save_fl edit this bit rather than the real
+ * hardware flag. Real IF stays SET the whole time the guest address space is
+ * current -- the host enters the guest with interrupts enabled and nothing in
+ * the guest may clear them.
+ *
+ * That is what keeps the host alive underneath a free-running guest. A real
+ * hardware interrupt vectors through the guest IDT into the passage-page stub,
+ * which performs a full world switch back to the host; the host, restored to
+ * its own context, replays the vector into Windows' live IDT and re-enters the
+ * guest at the interrupted instruction. So the host is never deaf for longer
+ * than one crossing, no matter what the guest is doing -- including the long
+ * stretches of early boot that run under a virtual cli with no cooperative
+ * boundary in sight. The previous policy (real IF clear, yield only at
+ * virtual-sti boundaries) froze the machine exactly there: the pinned core
+ * stopped answering the clock and every other core's TLB-shootdown IPIs
+ * within milliseconds of the guest running free.
+ *
+ * The virtual flag is still what Linux reads back: irqs_disabled() and
+ * saved-flags tests see the guest's own logical state, not the hardware bit
+ * the host owns.
+ *
+ * Holds X86_EFLAGS_IF or 0, so it substitutes directly into saved flags.
+ *
+ * One slot per guest processor. On real hardware this flag is a bit in a
+ * register, so every CPU has its own and a task carries its own copy in the
+ * EFLAGS it saved; a single global would mean one processor's cli silencing
+ * another's interrupts, and one processor's idle path deciding whether the
+ * *machine* has interrupts on.
+ *
+ * A plain array at a fixed link-time address, deliberately NOT a per-CPU
+ * variable. The host writes this before the guest runs and reads it through
+ * the guest's CR3 while the guest runs -- it is the gate that decides whether
+ * a cooperative timer tick may be injected -- so the address of every slot
+ * has to be one the host can compute from the symbol. A per-CPU variable
+ * physically moves when setup_per_cpu_areas() runs, and the host has no way
+ * to follow it there. The array base is slot 0, so the host's existing symbol
+ * lookup finds the boot processor's flag unchanged.
+ */
+#define CO_COLINUX_NR_VCPUS	4	/* CO_MAX_VCPUS on the host side */
+
+/*
+ * Which guest processor is executing this.
+ *
+ * The single place the answer is decided, so that making it a real answer is
+ * one edit rather than a search. Under CONFIG_SMP=n it is the constant 0 and
+ * every co_colinux_*[co_colinux_vcpu_id()] below folds back to the plain
+ * global access this port has always compiled.
+ */
+#ifndef CONFIG_SMP
+#define co_colinux_vcpu_id()	0u
+#else
+/*
+ * The Linux CPU number, which this port makes the vCPU index by construction:
+ * the host starts vCPU N as the guest's CPU N, so the two never diverge and
+ * there is no mapping table to keep honest.
+ *
+ * raw_cpu_read, not raw_smp_processor_id() and not __this_cpu_read. This
+ * header is included before almost everything and cannot reach <asm/smp.h>
+ * without circularity, so cpu_number is declared here -- the same
+ * declaration, which C permits, and asm/percpu.h is self-contained enough to
+ * include. The raw form is the one that carries no debug machinery at all:
+ * __this_cpu_read expands to a __this_cpu_preempt_check() that is static
+ * under CONFIG_DEBUG_PREEMPT, and native_save_fl() below is a non-static
+ * inline, so calling it does not even compile. These helpers are noinstr and
+ * want no instrumentation in them regardless.
+ *
+ * Reading the index without pinning to the CPU is correct for one processor
+ * and is a question again for several: a task that migrated between the read
+ * and the use would touch the slot of the CPU it came from. Real hardware has
+ * the same shape -- IF is per-CPU and a migrating task carries its logical
+ * state in its saved EFLAGS -- but the guest's slot is memory, not a register
+ * the switch restores, so rung S3 has to walk the call sites and say which
+ * ones need preemption held across the pair.
+ *
+ * Valid from the guest's first instruction, which is the part worth checking
+ * rather than assuming: the guest enters at co_arch_start_kernel and falls
+ * into common_startup_64, which writes MSR_GS_BASE from __per_cpu_offset[0]
+ * before any C code runs. Until setup_per_cpu_areas() the boot processor
+ * reads its per-CPU variables out of the init image, where cpu_number is 0 --
+ * correct for the boot CPU -- and afterwards out of its real area, where
+ * setup_per_cpu_areas() has written 0 into it. There is no window in which
+ * this returns the wrong answer for the boot processor.
+ */
+DECLARE_PER_CPU_CACHE_HOT(int, cpu_number);
+#define co_colinux_vcpu_id()	((unsigned int)raw_cpu_read(cpu_number))
+#endif
+
+extern unsigned long co_colinux_virtual_if[CO_COLINUX_NR_VCPUS];
+extern void co_colinux_yield(void);
+
+/*
+ * Interprocessor interrupts, as shared memory rather than as a chip.
+ *
+ * One 256-bit pending set per processor, host-visible for the same reason
+ * co_colinux_virtual_if is -- fixed arrays, never percpu, because the host
+ * reads and writes them from outside the guest. A sender sets the vector's
+ * bit in the target's set and rings the host doorbell; the target drains its
+ * own set at a safe point and runs the handlers.
+ *
+ * This replaces a local APIC that does not exist. The alternative, which this
+ * port ran into, is that every send_IPI is an MMIO store to a fixmap nobody
+ * ever mapped.
+ */
+#define CO_COLINUX_IPI_WORDS	4	/* 256 vectors, one bit each */
+extern unsigned long co_colinux_ipi_pending[CO_COLINUX_NR_VCPUS][CO_COLINUX_IPI_WORDS];
+extern void co_colinux_ipi_send(unsigned int cpu, int vector);
+extern void co_colinux_ipi_drain(void);
+extern void co_colinux_ipi_poll(void);
+
 /* Declaration required for gcc < 4.9 to prevent -Werror=missing-prototypes */
 extern inline unsigned long native_save_fl(void);
 extern __always_inline unsigned long native_save_fl(void)
@@ -29,27 +145,116 @@
 		     : /* no input */
 		     : "memory");
 
+	if (co_colinux_guest)
+		flags = (flags & ~X86_EFLAGS_IF) |
+			co_colinux_virtual_if[co_colinux_vcpu_id()];
+
 	return flags;
 }
 
 static __always_inline void native_irq_disable(void)
 {
+	if (co_colinux_guest) {
+		co_colinux_virtual_if[co_colinux_vcpu_id()] = 0;
+		asm volatile("": : :"memory");
+		return;
+	}
+
 	asm volatile("cli": : :"memory");
 }
 
 static __always_inline void native_irq_enable(void)
 {
+	if (co_colinux_guest) {
+		/*
+		 * The virtual bit, AND the real one.
+		 *
+		 * For most of this port the real flag needed no help here: the
+		 * host entered the guest with interrupts on and nothing in the
+		 * guest could clear them, because every cli was virtual and
+		 * every gate in the guest's IDT went straight to a host stub
+		 * that crossed back within microseconds.
+		 *
+		 * Owning the IDT ended that. Two things now clear the real
+		 * flag behind Linux's back, both in hardware, neither of them
+		 * anything the guest chose:
+		 *
+		 *   - an interrupt gate clears IF on delivery, and vectors
+		 *     0-31 are the kernel's own handlers now, so the flag
+		 *     stays clear for as long as the handler runs -- and a
+		 *     user page fault runs until the block layer has been to
+		 *     the disk and back.
+		 *   - SYSCALL clears IF from MSR_SYSCALL_MASK, so it stays
+		 *     clear for the whole system call.
+		 *
+		 * In both, Linux believes it re-enabled interrupts: syscall
+		 * entry calls local_irq_enable(), fault handlers call
+		 * cond_local_irq_enable(). Setting only the virtual bit there
+		 * left the processor deaf for the entire syscall or fault,
+		 * which is the host freeze -- the same failure as the old
+		 * yield-only policy, arriving by a new route.
+		 *
+		 * So sti here, where Linux says interrupts are on. It makes
+		 * the invariant repair itself: whatever cleared the real flag,
+		 * the next enable puts it back, and the windows that remain
+		 * are the short prologues Linux already keeps short. The
+		 * virtual bit continues to be what the guest reads back.
+		 */
+		co_colinux_virtual_if[co_colinux_vcpu_id()] = X86_EFLAGS_IF;
+		asm volatile("sti" : : : "memory");
+		return;
+	}
+
 	asm volatile("sti": : :"memory");
 }
 
 static __always_inline void native_safe_halt(void)
 {
+	/*
+	 * The idle halt, and the one the original no-halt patch missed.
+	 *
+	 * native_halt() below is the emergency halt every panic path ends in.
+	 * This is the other one: default_idle() reaches it through
+	 * raw_safe_halt(), so it is where a booted, idle guest waits. A guest
+	 * that reaches idle and really executes `sti; hlt` takes its core away
+	 * exactly as a panicking one would -- the boot succeeding is not a
+	 * reason to let it hang the host.
+	 *
+	 * Two ud2 rather than one. A single ud2 is how WARN and BUG trap, and
+	 * the host steps over a warning; the host must not step over a halt. No
+	 * WARN is ever followed by a second ud2, so `ud2; ud2` is a signature
+	 * the host can tell apart from a warning with certainty, and it stops
+	 * on it and reports the guest reached idle.
+	 */
+	if (co_colinux_guest)
+		asm volatile("ud2; ud2");
+
 	x86_idle_clear_cpu_buffers();
 	asm volatile("sti; hlt": : :"memory");
 }
 
+/*
+ * Cooperative Linux must never actually halt.
+ *
+ * The guest is code running inside a host process, on a CPU the host owns. HLT
+ * with interrupts disabled waits for an NMI or a reset, so a guest that reaches
+ * it takes that core away permanently -- the host cannot preempt it, the other
+ * cores notice, and the machine bugchecks. Every panic path ends in exactly
+ * this, so the failure that most wants reporting is the one that would take the
+ * host down instead.
+ *
+ * ud2 raises #UD, which reaches the host's stub through the guest IDT and
+ * returns control with the fault recorded. The i386 port does the same thing by
+ * calling co_terminate from head_32.S's hlt_loop; this is the same idea at the
+ * single place every halt goes through.
+ */
 static __always_inline void native_halt(void)
 {
+	/* ud2; ud2 -- the cooperative-halt signature, told apart from the
+	 * single ud2 of a WARN. See native_safe_halt above. */
+	if (co_colinux_guest)
+		asm volatile("ud2; ud2");
+
 	x86_idle_clear_cpu_buffers();
 	asm volatile("hlt": : :"memory");
 }
