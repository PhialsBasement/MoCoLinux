+		addr		= gate_offset(&host_gate[i]);
+		g.offset_low	= (u16)addr;
+		g.segment	= __KERNEL_CS;
+		g.bits.type	= GATE_INTERRUPT;
+		g.bits.p	= 1;
+		g.offset_middle	= (u16)(addr >> 16);
+		g.offset_high	= (u32)(addr >> 32);
+		write_idt_entry(idt_table, i, &g);
+	}
