+CO_COLINUX_BUILDIO(w, u16)
+CO_COLINUX_BUILDIO(l, u32)
+#undef CO_COLINUX_BUILDIO
+
+#undef inb
+#undef inw
+#undef inl
+#undef outb
+#undef outw
+#undef outl
+#define inb co_colinux_inb
+#define inw co_colinux_inw
+#define inl co_colinux_inl
+#define outb co_colinux_outb
+#define outw co_colinux_outw
+#define outl co_colinux_outl
