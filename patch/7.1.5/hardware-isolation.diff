+/*
+ * A cooperative guest shares the real processor with Windows; it does not
+ * own the processor's I/O-port namespace.  Native PCI probing through CF8/CFC
+ * was enough to discover the host's Intel SATA controller, after which
+ * ata_piix programmed that live controller and froze the host.
+ *
+ * Keep the native helpers available for a normal boot, but turn every port
+ * read into the value of an absent device and every port write into a no-op
+ * while the cooperative guest is current.  Synthetic coLinux devices use the
+ * passage page and do not depend on physical port I/O.
+ */
+extern int co_colinux_guest;
+
+#define CO_COLINUX_BUILDIO(bwl, type)                                    \
+static __always_inline void co_colinux_out##bwl(type value, u16 port)     \
+{                                                                         \
+	if (unlikely(co_colinux_guest))                                     \
+		return;                                                       \
+	__out##bwl(value, port);                                             \
+}                                                                         \
+                                                                          \
+static __always_inline type co_colinux_in##bwl(u16 port)                  \
+{                                                                         \
+	if (unlikely(co_colinux_guest))                                     \
+		return (type)~0U;                                             \
+	return __in##bwl(port);                                              \
+}
