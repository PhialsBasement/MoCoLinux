+/*
+ * Cooperative Linux: an early console that writes into the passage page.
+ *
+ * There is no device here to talk to. The guest runs inside a host process's
+ * address space and its only channel out is memory both sides can see, so the
+ * console appends bytes to a ring in the passage page and the host drains it
+ * after the next world switch.
+ *
+ * co_colinux_console_ring is filled in by the host before the guest executes
+ * anything. That matters: it means output works from the very first
+ * instruction, rather than from whenever setup_early_printk() happens to run
+ * during setup_arch(). A real machine has to bootstrap its own console and is
+ * blind until it does; the host can simply write the pointer in beforehand,
+ * and being blind through early boot is exactly how a port like this gets
+ * stuck.
+ *
+ * written counts everything the guest tried to emit, including what did not
+ * fit. The host compares it against capacity to report truncation rather than
+ * silently showing a short log.
+ */
+struct co_console_ring {
+	volatile unsigned long long written;
+	volatile unsigned long long capacity;
+	volatile char text[];
+};
+
+struct co_console_ring *co_colinux_console_ring;
+EXPORT_SYMBOL(co_colinux_console_ring);
+
+/*
+ * Set by the host before the guest runs. Distinct from the console ring so that
+ * "is this a cooperative guest" is not inferred from "does it have somewhere to
+ * print", which are different questions that happen to coincide today.
+ */
+int co_colinux_guest;
+EXPORT_SYMBOL(co_colinux_guest);
+
+static void early_colinux_write(struct console *con, const char *s, unsigned n)
+{
+	struct co_console_ring *ring = co_colinux_console_ring;
+
+	if (!ring)
+		return;
+
+	while (n-- > 0) {
+		if (ring->written < ring->capacity)
+			ring->text[ring->written] = *s;
+		ring->written++;
+		s++;
+	}
+}
+
+static struct console early_colinux_console = {
+	.name =		"earlycolinux",
+	.write =	early_colinux_write,
+	.flags =	CON_PRINTBUFFER,
+	.index =	-1,
+};
+
+/*
+ * Register the cooperative console as early as setup_arch can manage.
+ *
+ * Waiting for parse_early_param() to act on earlyprintk= is too late. In
+ * setup_arch the order is idt_setup_early_traps() at the top, then
+ * e820__memory_setup(), then parse_early_param() -- so the stretch where a
+ * cooperative guest is most likely to die first is also the stretch with no
+ * console registered and, because the kernel has just replaced the host's
+ * interrupt stubs, nothing able to report a fault either.
+ *
+ * Self-gating: it does nothing unless the host has filled in the ring pointer,
+ * so a kernel booted normally on real hardware is unaffected.
+ */
+static void early_console_register(struct console *con, int keep_early);
+
+void co_colinux_console_init(void)
+{
+	if (!co_colinux_console_ring)
+		return;
+	if (early_console)
+		return;
+
+	early_console_register(&early_colinux_console, 1);
+}
+
 static void early_console_register(struct console *con, int keep_early)
 {
 	if (con->index != -1) {
