+/*
+ * Register the cooperative console as early as setup_arch can manage.
+ *
+ * Waiting for parse_early_param() to act on earlyprintk= is too late. In
+ * setup_arch the order is idt_setup_early_traps() at the top, then
+ * e820__memory_setup(), then parse_early_param() -- so the stretch where a
+ * cooperative guest is most likely to die first is also the stretch with no
+ * console registered and, because the kernel has just replaced the host's
+ * interrupt stubs, nothing able to report a fault either.
+ *
+ * Self-gating: it does nothing unless the host has filled in the ring pointer,
+ * so a kernel booted normally on real hardware is unaffected.
+ */
+static void early_console_register(struct console *con, int keep_early);
+
+void co_colinux_console_init(void)
+{
+	if (!co_colinux_console_ring)
+		return;
+	if (early_console)
+		return;
+
+	early_console_register(&early_colinux_console, 1);
+}
+
 static void early_console_register(struct console *con, int keep_early)
 {
 	if (con->index != -1) {
