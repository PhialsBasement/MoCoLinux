+/*
+ * Cooperative Linux keeps the host's interrupt table.
+ *
+ * The host installs an IDT whose every vector lands on a stub that records what
+ * happened and hands control back, on an IST stack so that even a destroyed
+ * stack pointer is survivable. Replacing it with the kernel's own during early
+ * boot removes the only thing able to report a fault, at exactly the point
+ * where faults are expected -- and a fault whose handler is not ready is a
+ * double fault, and then a triple fault, which resets the machine the guest is
+ * a process inside.
+ *
+ * So while bringing a guest up, these are left alone. The kernel runs on the
+ * host's stubs, every exception is reported, and nothing can escalate. A guest
+ * that is actually working will want its own traps eventually; that is a later
+ * decision, and it belongs after the kernel can survive taking one.
+ */
 void __init idt_setup_early_traps(void)
 {
+	if (co_colinux_guest)
+		return;
+
