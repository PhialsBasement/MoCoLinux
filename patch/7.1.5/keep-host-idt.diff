 #include <linux/memblock.h>
 #include <linux/cc_platform.h>
 #include <linux/pgtable.h>
+#include <linux/console.h>	/* co_colinux_guest */

 #include <asm/asm.h>
 #include <asm/page_64.h>
@@ -313,6 +314,27 @@
 void early_setup_idt(void)
 {
 	void *handler = NULL;
+
+	/*
+	 * The first IDT load a cooperative guest reaches, and the one that
+	 * matters most.
+	 *
+	 * idt.c has four of these and all four are already skipped, but none of
+	 * them runs this early: head_64.S calls here about twenty-five
+	 * instructions after the host hands control over, long before
+	 * start_kernel. Letting it through replaces the host's stubs with the
+	 * bringup table, and with them goes the debug trap the host is using to
+	 * single-step the guest -- which is the only bound on a guest running
+	 * with interrupts disabled. The guest then runs away inside the host's
+	 * ioctl and the machine stops responding entirely: no bugcheck, no
+	 * dump, no reset, power button.
+	 *
+	 * So the host's table stays. Every exception the early kernel takes is
+	 * still reported, and stepping still ends the guest's turn.
+	 */
+	if (co_colinux_guest)
+		return;

 	if (IS_ENABLED(CONFIG_AMD_MEM_ENCRYPT)) {
 		setup_ghcb();

